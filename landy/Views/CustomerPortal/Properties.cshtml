@model IReadOnlyList<Ardak.Application.DTOs.CustomerPropertySummaryDto>
@{
    ViewData["Title"] = "عقاراتي";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">بوابة العميل</a></li>
        <li class="breadcrumb-item active text-muted">عقاراتي</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-buildings text-primary me-2"></i>سجل عقاراتي
        </h1>
        <p class="text-muted mb-0 small">استعراض كافة العقارات المسجلة الخاصة بك ومتابعة حالتها ومعاملاتها</p>
    </div>
    <span class="badge bg-white text-muted border px-3 py-2 rounded-pill fs-6 shadow-sm">
        إجمالي العقارات: <strong class="text-primary font-monospace">@Model.Count</strong>
    </span>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <div class="feature-icon bg-light text-muted p-3 rounded-circle d-inline-flex mb-3">
                <i class="bi bi-building-slash fs-1"></i>
            </div>
            <h5 class="fw-bold">لا توجد عقارات مسجلة حالياً</h5>
            <p class="text-muted small mb-0">لم يتم ربط أي عقارات بحسابك حتى الآن. للتواصل يرجى مراجعة إدارة النظام.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100 ardak-hover-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@p.Type</span>
                            <span class="badge bg-secondary-subtle text-secondary border">@p.Status</span>
                        </div>
                        <h5 class="fw-bold mb-1 text-dark">@p.Title</h5>
                        <p class="text-muted small mb-3">الرقم المرجعي: <code class="bg-light px-2 py-1 rounded">@p.ReferenceNumber</code></p>

                        <div class="small mb-3 text-muted">
                            <div class="mb-1"><i class="bi bi-geo-alt text-danger me-1"></i>@p.DistrictOrArea، @p.City</div>
                            <div class="mb-1"><i class="bi bi-rulers text-info me-1"></i>المساحة: <strong>@p.AreaMeasurement.ToString("N0") @p.AreaUnit</strong></div>
                            <div><i class="bi bi-person-check text-success me-1"></i>صفة الملكية: <strong>@p.OwnershipRole</strong></div>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div class="small text-muted">
                                <i class="bi bi-clipboard2-check text-primary me-1"></i>
                                <span>@p.ApprovedProceduresCount معاملة معتمدة</span>
                            </div>
                            <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <span>التفاصيل</span>
                                <i class="bi bi-arrow-left ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
