@model IReadOnlyList<Ardak.Application.DTOs.CustomerPropertySummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "سجل عقاراتي";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">بوابة العميل</a></li>
        <li class="breadcrumb-item active text-muted">عقاراتي</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3 fade-in">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 fw-800 mb-0">
                <i class="bi bi-buildings text-primary me-2"></i>سجل عقاراتي المعتمدة
            </h1>
            <span class="badge badge-subtle-success">موثقة رسمياً</span>
        </div>
        <p class="text-muted mb-0 small">استعراض كافة الأصول العقارية المسجلة باسمك ومتابعة حالتها التشغيلية وصكوكها</p>
    </div>
    <span class="badge badge-subtle-primary fs-6 px-3 py-2 shadow-xs">
        إجمالي المحفظة: <strong class="font-monospace text-primary ms-1">@Model.Count</strong> عقار
    </span>
</div>

@if (!Model.Any())
{
    <div class="card border-0 py-5">
        <div class="luxury-empty-state">
            <div class="luxury-empty-icon">
                <i class="bi bi-buildings"></i>
            </div>
            <h5>لا توجد عقارات مسجلة حالياً</h5>
            <p>لم يتم ربط أي أصول عقارية بحسابك حتى الآن. للتواصل وطلب إضافة عقار، يرجى التنسيق مع إدارة المنصة.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="realestate-card fade-in">
                    <!-- Architectural Imagery Box -->
                    <div class="realestate-img-box" style="background: @(p.Type == PropertyType.Land ? "linear-gradient(135deg, #182d44 0%, #0f2236 100%)" : "linear-gradient(135deg, #122f4b 0%, #0a1520 100%)");">
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-white p-3 text-center">
                            <i class="@(p.Type == PropertyType.Land ? "bi bi-geo" : "bi bi-house-door") fs-1 mb-2" style="color: @(p.Type == PropertyType.Land ? "var(--gold-400)" : "var(--emerald-400)");"></i>
                            <span class="fw-bold small">@(p.Type == PropertyType.Land ? "أرض استثمارية" : "فيلا سكنية فاخرة")</span>
                            <span class="small" style="color: rgba(255, 255, 255, 0.55); font-size: 0.76rem;">@p.City &bull; @p.DistrictOrArea</span>
                        </div>
                        <div class="realestate-badge-top">
                            <span class="badge @(p.Type == PropertyType.Land ? "badge-subtle-gold" : "badge-subtle-primary")">
                                @(p.Type == PropertyType.Land ? "أرض" : "فيلا")
                            </span>
                        </div>
                        <div class="realestate-badge-left">
                            <span class="badge badge-subtle-secondary" style="background: rgba(10, 21, 32, 0.7); color: #fff; border: 1px solid rgba(255, 255, 255, 0.2);">
                                @p.Status
                            </span>
                        </div>
                    </div>

                    <div class="realestate-body">
                        <h5 class="realestate-title">@p.Title</h5>
                        <div class="realestate-ref font-monospace">@p.ReferenceNumber</div>

                        <div class="realestate-specs">
                            <div class="realestate-spec-item">
                                <i class="bi bi-geo-alt"></i>
                                <span>@p.DistrictOrArea، @p.City</span>
                            </div>
                            <div class="realestate-spec-item">
                                <i class="bi bi-bounding-box"></i>
                                <span class="font-monospace">@p.AreaMeasurement.ToString("N0") @p.AreaUnit</span>
                            </div>
                            <div class="realestate-spec-item">
                                <i class="bi bi-person-check"></i>
                                <span>@p.OwnershipRole</span>
                            </div>
                        </div>

                        <div class="realestate-footer">
                            <div class="small text-muted">
                                <i class="bi bi-clipboard2-check text-primary me-1"></i>
                                <span class="fw-bold text-dark">@p.ApprovedProceduresCount</span> معاملة معتمدة
                            </div>
                            <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <span>ملف العقار</span>
                                <i class="bi bi-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
