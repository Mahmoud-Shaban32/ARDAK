@model Ardak.Application.DTOs.CustomerProcedureDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تفاصيل المعاملة – {Model.TypeLabel}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">بوابة العميل</a></li>
        <li class="breadcrumb-item"><a asp-action="PropertyDetails" asp-route-id="@Model.PropertyId" class="text-decoration-none">العقار: @Model.PropertyReferenceNumber</a></li>
        <li class="breadcrumb-item active text-muted">@Model.TypeLabel</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 fw-bold mb-0">
                <i class="bi bi-file-earmark-check text-primary me-2"></i>@Model.TypeLabel
            </h1>
            <partial name="_ProcedureStatusBadge" model="Model.Status" />
        </div>
        <p class="text-muted mb-0 small">
            العقار المرتبط:
            <a asp-action="PropertyDetails" asp-route-id="@Model.PropertyId" class="text-decoration-none fw-semibold">
                @Model.PropertyReferenceNumber &ndash; @Model.PropertyTitle
            </a>
        </p>
    </div>
    <a asp-action="PropertyDetails" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-right"></i>
        <span>العودة للعقار</span>
    </a>
</div>

<div class="row g-4">
    <!-- بيانات وحالة المعاملة الرسمية -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary fs-5"></i>
                <span>بيانات المعاملة الرسمية</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0 g-2">
                    <dt class="col-sm-5 text-muted small">نوع المعاملة</dt>
                    <dd class="col-sm-7 fw-bold text-dark">@Model.TypeLabel</dd>

                    <dt class="col-sm-5 text-muted small">رقم المعاملة / القيد</dt>
                    <dd class="col-sm-7 font-monospace">@(Model.ApplicationNumber ?? "—")</dd>

                    <dt class="col-sm-5 text-muted small">الجهة المسؤولة</dt>
                    <dd class="col-sm-7 fw-semibold">@(Model.ResponsibleAuthority ?? "الجهة الرسمية المختصة")</dd>

                    <dt class="col-sm-5 text-muted small">الحالة الراهنة</dt>
                    <dd class="col-sm-7"><partial name="_ProcedureStatusBadge" model="Model.Status" /></dd>

                    <dt class="col-sm-5 text-muted small">تاريخ التقديم</dt>
                    <dd class="col-sm-7">@(Model.SubmissionDate.HasValue ? Model.SubmissionDate.Value.ToString("dd MMMM yyyy") : "—")</dd>

                    <dt class="col-sm-5 text-muted small">تاريخ الإدراج في النظام</dt>
                    <dd class="col-sm-7 text-muted">@Model.CreatedAtUtc.ToString("dd MMMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- آخر التحديثات والملاحظات الموجهة للعميل -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text text-info fs-5"></i>
                <span>آخر مستجدات وتحديثات المعاملة</span>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                @if (!string.IsNullOrWhiteSpace(Model.CustomerUpdateNotes))
                {
                    <div class="p-3 bg-light rounded-3 border-start border-4 border-info">
                        <div class="text-muted small mb-1 fw-bold">إفادة الفريق القانوني:</div>
                        <p class="mb-0 fw-semibold text-dark">@Model.CustomerUpdateNotes</p>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-clock-history fs-2 text-secondary mb-2 d-block"></i>
                        <p class="mb-0 small">المعاملة قيد المتابعة والإجراء الرسمي لدى الجهات المعنية. ستظهر أي مستجدات أو تحديثات معتمدة هنا فور صدورها.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- المستندات المعتمدة المرتبطة بالمعاملة -->
    @if (Model.ApprovedDocuments.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-arrow-down text-success fs-5"></i>
                        <span>المستندات والمرفقات الرسمية المعتمدة (@Model.ApprovedDocuments.Count)</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>عنوان المستند</th>
                                    <th>التصنيف</th>
                                    <th>الحجم</th>
                                    <th>تاريخ الرفع</th>
                                    <th class="text-end">تحميل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.ApprovedDocuments)
                                {
                                    <tr>
                                        <td class="fw-bold">
                                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                            @doc.Title
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@doc.DocumentType</span></td>
                                        <td class="small text-muted font-monospace">@doc.FormattedFileSize</td>
                                        <td class="small text-muted">@doc.UploadDateUtc.ToString("dd MMMM yyyy")</td>
                                        <td class="text-end">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-download me-1"></i>
                                                <span>تحميل الملف</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
