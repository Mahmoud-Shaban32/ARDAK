@model Ardak.Application.DTOs.CustomerProcedureDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تفاصيل المعاملة – {Model.TypeLabel}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">بوابة العميل</a></li>
        <li class="breadcrumb-item"><a asp-action="PropertyDetails" asp-route-id="@Model.PropertyId" class="text-decoration-none">العقار: @Model.PropertyReferenceNumber</a></li>
        <li class="breadcrumb-item active text-muted">@Model.TypeLabel</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3 fade-in">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="h3 fw-800 mb-0">
                <i class="bi bi-file-earmark-check text-primary me-2"></i>@Model.TypeLabel
            </h1>
            <partial name="_ProcedureStatusBadge" model="Model.Status" />
        </div>
        <p class="text-muted mb-0 small">
            العقار المرتبط:
            <a asp-action="PropertyDetails" asp-route-id="@Model.PropertyId" class="text-decoration-none fw-600 text-primary">
                @Model.PropertyReferenceNumber &ndash; @Model.PropertyTitle
            </a>
        </p>
    </div>
    <a asp-action="PropertyDetails" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-right"></i>
        <span>العودة للعقار</span>
    </a>
</div>

<div class="row g-4">
    <!-- بيانات وحالة المعاملة الرسمية -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i>
                <span>بيانات المعاملة الرسمية</span>
            </div>
            <div class="card-body p-4">
                <div class="info-section-row">
                    <span class="info-lbl">نوع المعاملة</span>
                    <span class="info-val fw-700 text-dark">@Model.TypeLabel</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">رقم المعاملة / القيد</span>
                    <span class="info-val font-monospace">@(Model.ApplicationNumber ?? "—")</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">الجهة المسؤولة</span>
                    <span class="info-val fw-600">@(Model.ResponsibleAuthority ?? "الجهة الرسمية المختصة")</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">الحالة الراهنة</span>
                    <span class="info-val"><partial name="_ProcedureStatusBadge" model="Model.Status" /></span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">تاريخ التقديم</span>
                    <span class="info-val">@(Model.SubmissionDate.HasValue ? Model.SubmissionDate.Value.ToString("dd MMMM yyyy") : "—")</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">تاريخ التسجيل</span>
                    <span class="info-val text-muted">@Model.CreatedAtUtc.ToString("dd MMMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- آخر التحديثات والملاحظات الموجهة للعميل -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text text-info"></i>
                <span>آخر مستجدات وتحديثات المعاملة</span>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-center">
                @if (!string.IsNullOrWhiteSpace(Model.CustomerUpdateNotes))
                {
                    <div class="p-3 rounded-3" style="background: var(--cyan-light); border-right: 4px solid var(--cyan);">
                        <div class="text-muted small mb-1 fw-bold">إفادة الفريق القانوني:</div>
                        <p class="mb-0 fw-600 text-dark">@Model.CustomerUpdateNotes</p>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-clock-history"></i>
                        <h6>قيد المتابعة الدورية</h6>
                        <p>المعاملة قيد المتابعة والإجراء الرسمي لدى الجهات المعنية. ستظهر أي مستجدات فور اعتمادها.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- المستندات المعتمدة المرتبطة بالمعاملة -->
    @if (Model.ApprovedDocuments.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 fw-700">
                        <i class="bi bi-file-earmark-arrow-down text-success"></i>
                        <span>المستندات والمرفقات الرسمية المعتمدة (@Model.ApprovedDocuments.Count)</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>عنوان المستند</th>
                                    <th>التصنيف</th>
                                    <th>الحجم</th>
                                    <th>تاريخ الرفع</th>
                                    <th class="text-end">تحميل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.ApprovedDocuments)
                                {
                                    <tr>
                                        <td class="fw-700 text-dark">
                                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                            @doc.Title
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@doc.DocumentType</span></td>
                                        <td class="small text-muted font-monospace">@doc.FormattedFileSize</td>
                                        <td class="small text-muted">@doc.UploadDateUtc.ToString("dd MMMM yyyy")</td>
                                        <td class="text-end">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-download me-1"></i>
                                                <span>تحميل الملف</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
