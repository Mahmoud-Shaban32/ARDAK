@model Ardak.Application.DTOs.CustomerPropertyDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تفاصيل العقار – {Model.ReferenceNumber}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">بوابة العميل</a></li>
        <li class="breadcrumb-item"><a asp-action="Properties" class="text-decoration-none">عقاراتي</a></li>
        <li class="breadcrumb-item active text-muted">@Model.ReferenceNumber</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 fw-bold mb-0">
                <i class="bi bi-building text-primary me-2"></i>@Model.Title
            </h1>
            <span class="badge bg-secondary-subtle text-secondary border">@Model.Status</span>
        </div>
        <p class="text-muted mb-0 small">
            الرقم المرجعي: <code class="bg-light px-2 py-1 rounded">@Model.ReferenceNumber</code> &bull; النوع: <strong class="text-dark">@Model.Type</strong>
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6">
            <i class="bi bi-person-check me-1"></i>
            @Model.OwnershipRole
            @if (Model.OwnershipPercentage.HasValue)
            {
                <span dir="ltr">(@Model.OwnershipPercentage.Value.ToString("0.##")%)</span>
            }
        </span>
        <a asp-action="Properties" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-right"></i>
            <span>العودة لعقاراتي</span>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- 1. الموقع والمساحة -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-geo-alt text-primary fs-5"></i>
                <span>بيانات الموقع والمساحة</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0 g-2">
                    <dt class="col-sm-4 text-muted small">المدينة / المنطقة</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@Model.City، @Model.Governorate</dd>

                    <dt class="col-sm-4 text-muted small">الحي / المخطط</dt>
                    <dd class="col-sm-8">@Model.DistrictOrArea</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.AddressDetails))
                    {
                        <dt class="col-sm-4 text-muted small">تفاصيل العنوان</dt>
                        <dd class="col-sm-8">@Model.AddressDetails</dd>
                    }

                    <dt class="col-sm-4 text-muted small">المساحة الإجمالية</dt>
                    <dd class="col-sm-8 fw-bold text-primary font-monospace">@Model.AreaMeasurement.ToString("N2") @Model.AreaUnit</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <dt class="col-sm-4 text-muted small">الوصف والملاحظات</dt>
                        <dd class="col-sm-8 text-muted">@Model.Description</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <!-- 2. الصك والملكية -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-check text-success fs-5"></i>
                <span>بيانات الصك والملكية الرسمية</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0 g-2">
                    <dt class="col-sm-4 text-muted small">نوع الملكية</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.OwnershipType ?? "ملكية كاملة")</dd>

                    <dt class="col-sm-4 text-muted small">رقم الصك / الوثيقة</dt>
                    <dd class="col-sm-8 font-monospace">
                        @if (!string.IsNullOrWhiteSpace(Model.DeedOrTitleNumber))
                        {
                            <span class="badge bg-light text-dark border">@Model.DeedOrTitleNumber</span>
                        }
                        else
                        {
                            <span class="text-muted">مقيد في السجل الرسمي</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small">صفة العميل بالعقار</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model.OwnershipRole</dd>

                    <dt class="col-sm-4 text-muted small">الحالة التشغيلية</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary-subtle text-secondary border">@Model.Status</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- 3. المعاملات والإجراءات المعتمدة -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 fw-bold">
                    <i class="bi bi-clipboard2-check text-info fs-5"></i>
                    <span>المعاملات والإجراءات القانونية المعتمدة</span>
                </div>
                <span class="badge bg-light text-muted border">@Model.ApprovedProcedures.Count معاملة مسجلة</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedProcedures.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-clipboard-x fs-2 d-block mb-1 text-secondary"></i>
                        لا توجد معاملات منشورة حالياً لهذا العقار.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>نوع المعاملة</th>
                                    <th>رقم الطلب / القيد</th>
                                    <th>الجهة المختصة</th>
                                    <th>الحالة</th>
                                    <th>آخر تحديث</th>
                                    <th class="text-end">التفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pr in Model.ApprovedProcedures)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border fw-bold">@pr.TypeLabel</span>
                                        </td>
                                        <td class="font-monospace">@(pr.ApplicationNumber ?? "—")</td>
                                        <td>@(pr.ResponsibleAuthority ?? "—")</td>
                                        <td><partial name="_ProcedureStatusBadge" model="pr.Status" /></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(pr.CustomerUpdateNotes))
                                            {
                                                <span class="text-dark small">@pr.CustomerUpdateNotes</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">المعاملة قيد المتابعة الاعتيادية</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="ProcedureDetails" asp-route-id="@pr.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <span>عرض</span>
                                                <i class="bi bi-arrow-left ms-1"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 4. المستندات الرسمية المعتمدة -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 fw-bold">
                    <i class="bi bi-file-earmark-arrow-down text-success fs-5"></i>
                    <span>المستندات المعتمدة للعقار</span>
                </div>
                <span class="badge bg-light text-muted border">@Model.ApprovedDocuments.Count مستند</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedDocuments.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-folder-check fs-2 d-block mb-1 text-secondary"></i>
                        لا توجد مستندات معتمدة متاحة للعرض حالياً لهذا العقار.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>عنوان المستند</th>
                                    <th>التصنيف</th>
                                    <th>الملف الأصلي</th>
                                    <th>الحجم</th>
                                    <th>تاريخ الرفع</th>
                                    <th class="text-end">تحميل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.ApprovedDocuments)
                                {
                                    <tr>
                                        <td class="fw-bold">
                                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                            @doc.Title
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@doc.DocumentType</span></td>
                                        <td><code class="small">@doc.OriginalFileName</code></td>
                                        <td class="small text-muted font-monospace">@doc.FormattedFileSize</td>
                                        <td class="small text-muted">@doc.UploadDateUtc.ToString("dd MMMM yyyy")</td>
                                        <td class="text-end">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-download me-1"></i>
                                                <span>تحميل</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
