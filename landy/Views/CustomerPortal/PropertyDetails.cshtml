@model Ardak.Application.DTOs.CustomerPropertyDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تفاصيل العقار – {Model.ReferenceNumber}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">بوابة العميل</a></li>
        <li class="breadcrumb-item"><a asp-action="Properties" class="text-decoration-none">عقاراتي</a></li>
        <li class="breadcrumb-item active text-muted">@Model.ReferenceNumber</li>
    </ol>
</nav>

<!-- ══ PROPERTY HERO ════════════════════════════════════════ -->
<div class="property-hero fade-in mb-4">
    <div class="d-flex align-items-start gap-4 flex-wrap" style="position:relative;z-index:1;">
        <div class="property-hero-icon">
            <i class="@(Model.Type == PropertyType.Land ? "bi bi-geo" : "bi bi-house-door")"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge" style="background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.9);border:1px solid rgba(255,255,255,0.22);">
                    @(Model.Type == PropertyType.Land ? "أرض" : "فيلا")
                </span>
                <span class="badge badge-subtle-secondary">@Model.Status</span>
            </div>
            <h1 class="property-hero-title">@Model.Title</h1>
            <p class="property-hero-sub mb-3">
                <i class="bi bi-hash me-1"></i>@Model.ReferenceNumber
                &bull;
                <i class="bi bi-geo-alt me-1"></i>@Model.DistrictOrArea، @Model.City
            </p>
            <div class="d-flex flex-wrap gap-2">
                <span class="hero-stat-pill">
                    <i class="bi bi-rulers"></i>
                    @Model.AreaMeasurement.ToString("N2") @Model.AreaUnit
                </span>
                <span class="hero-stat-pill">
                    <i class="bi bi-person-check"></i>
                    @Model.OwnershipRole
                    @if (Model.OwnershipPercentage.HasValue)
                    {
                        <span dir="ltr">(@Model.OwnershipPercentage.Value.ToString("0.##")%)</span>
                    }
                </span>
                @if (!string.IsNullOrEmpty(Model.OwnershipType))
                {
                    <span class="hero-stat-pill">
                        <i class="bi bi-file-earmark-check"></i>
                        @Model.OwnershipType
                    </span>
                }
            </div>
        </div>
        <div class="ms-auto d-none d-md-block">
            <a asp-action="Properties" class="btn btn-sm rounded-pill px-3" style="background:rgba(255,255,255,0.12);color:#fff;border:1px solid rgba(255,255,255,0.22);">
                <i class="bi bi-arrow-right"></i>
                <span>العودة لعقاراتي</span>
            </a>
        </div>
    </div>
</div>

<!-- Mobile back button -->
<div class="d-md-none mb-3">
    <a asp-action="Properties" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-right"></i>
        <span>العودة لعقاراتي</span>
    </a>
</div>

<!-- ══ DETAILS GRID ══════════════════════════════════════════ -->
<div class="row g-4">

    <!-- Location & Area -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-geo-alt text-primary"></i>
                <span>بيانات الموقع والمساحة</span>
            </div>
            <div class="card-body p-4">
                <div class="info-section-row">
                    <span class="info-lbl">المدينة / المنطقة</span>
                    <span class="info-val fw-600">@Model.City، @Model.Governorate</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">الحي / المخطط</span>
                    <span class="info-val">@Model.DistrictOrArea</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.AddressDetails))
                {
                    <div class="info-section-row">
                        <span class="info-lbl">تفاصيل العنوان</span>
                        <span class="info-val">@Model.AddressDetails</span>
                    </div>
                }
                <div class="info-section-row">
                    <span class="info-lbl">المساحة الإجمالية</span>
                    <span class="info-val fw-700 text-primary font-monospace">@Model.AreaMeasurement.ToString("N2") @Model.AreaUnit</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="info-section-row">
                        <span class="info-lbl">الوصف</span>
                        <span class="info-val text-muted">@Model.Description</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Deed & Ownership -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-check text-success"></i>
                <span>بيانات الصك والملكية الرسمية</span>
            </div>
            <div class="card-body p-4">
                <div class="info-section-row">
                    <span class="info-lbl">نوع الملكية</span>
                    <span class="info-val fw-600">@(Model.OwnershipType ?? "ملكية كاملة")</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">رقم الصك</span>
                    <span class="info-val">
                        @if (!string.IsNullOrWhiteSpace(Model.DeedOrTitleNumber))
                        {
                            <span class="badge bg-light text-dark border font-monospace">@Model.DeedOrTitleNumber</span>
                        }
                        else
                        {
                            <span class="text-muted">مقيد في السجل الرسمي</span>
                        }
                    </span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">صفة العميل</span>
                    <span class="info-val fw-700 text-dark">@Model.OwnershipRole</span>
                </div>
                @if (Model.OwnershipPercentage.HasValue)
                {
                    <div class="info-section-row">
                        <span class="info-lbl">نسبة الملكية</span>
                        <span class="info-val fw-700 text-primary" dir="ltr">@Model.OwnershipPercentage.Value.ToString("0.##")%</span>
                    </div>
                }
                <div class="info-section-row">
                    <span class="info-lbl">الحالة التشغيلية</span>
                    <span class="info-val"><span class="badge-subtle-secondary badge">@Model.Status</span></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Approved Procedures -->
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 fw-700">
                    <i class="bi bi-clipboard2-check text-info"></i>
                    <span>المعاملات والإجراءات القانونية المعتمدة</span>
                </div>
                <span class="badge-subtle-info badge">@Model.ApprovedProcedures.Count معاملة</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedProcedures.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-clipboard-x"></i>
                        <h6>لا توجد معاملات معتمدة</h6>
                        <p>لا توجد معاملات منشورة حالياً لهذا العقار.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>نوع المعاملة</th>
                                    <th>رقم الطلب</th>
                                    <th>الجهة المختصة</th>
                                    <th>الحالة</th>
                                    <th>آخر تحديث</th>
                                    <th class="text-end">التفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pr in Model.ApprovedProcedures)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border fw-700">@pr.TypeLabel</span></td>
                                        <td class="font-monospace small">@(pr.ApplicationNumber ?? "—")</td>
                                        <td>@(pr.ResponsibleAuthority ?? "—")</td>
                                        <td><partial name="_ProcedureStatusBadge" model="pr.Status" /></td>
                                        <td class="small">
                                            @if (!string.IsNullOrWhiteSpace(pr.CustomerUpdateNotes))
                                            {
                                                <span class="text-dark">@pr.CustomerUpdateNotes</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">المعاملة قيد المتابعة</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="ProcedureDetails" asp-route-id="@pr.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                                <span>عرض</span>
                                                <i class="bi bi-arrow-left"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Approved Documents -->
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 fw-700">
                    <i class="bi bi-file-earmark-arrow-down text-success"></i>
                    <span>المستندات المعتمدة للعقار</span>
                </div>
                <span class="badge-subtle-success badge">@Model.ApprovedDocuments.Count مستند</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedDocuments.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-folder-check"></i>
                        <h6>لا توجد مستندات متاحة</h6>
                        <p>لا توجد مستندات معتمدة متاحة للعرض حالياً لهذا العقار.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>عنوان المستند</th>
                                    <th>التصنيف</th>
                                    <th>الملف</th>
                                    <th>الحجم</th>
                                    <th>تاريخ الرفع</th>
                                    <th class="text-end">تحميل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.ApprovedDocuments)
                                {
                                    <tr>
                                        <td class="fw-700">
                                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                            @doc.Title
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@doc.DocumentType</span></td>
                                        <td><code class="small">@doc.OriginalFileName</code></td>
                                        <td class="small text-muted font-monospace">@doc.FormattedFileSize</td>
                                        <td class="small text-muted">@doc.UploadDateUtc.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-success rounded-pill px-3 py-1">
                                                <i class="bi bi-download"></i>
                                                <span>تحميل</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
