@model Ardak.Application.DTOs.CustomerPortalDashboardDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "بوابة العميل";
}

<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-person-badge text-primary me-2"></i>مرحباً بك، @Model.Profile.FullName
        </h1>
        <p class="text-muted mb-0 small">
            بوابة عملاء أرضك &mdash; استعراض سجلات العقارات المعتمدة ومتابعة مسار المعاملات
        </p>
    </div>
    <span class="badge badge-subtle-success px-3 py-2 fs-7 d-inline-flex align-items-center gap-1 shadow-xs">
        <i class="bi bi-shield-check"></i>
        <span>حساب عميل معتمد وموثّق</span>
    </span>
</div>

<div class="row g-4">
    <!-- Customer Profile Summary Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-primary fs-5"></i>
                <span>الملف الشخصي للعميل</span>
            </div>
            <div class="card-body">
                <div class="mb-3 pb-2 border-bottom">
                    <span class="text-muted small d-block">الرقم المرجعي للعميل</span>
                    <span class="fw-bold font-monospace text-primary">#CUST-@Model.Profile.Id.ToString("D5")</span>
                </div>
                <div class="mb-3 pb-2 border-bottom">
                    <span class="text-muted small d-block">الاسم الكامل</span>
                    <span class="fw-bold text-dark">@Model.Profile.FullName</span>
                </div>
                <div class="mb-3 pb-2 border-bottom">
                    <span class="text-muted small d-block">البريد الإلكتروني</span>
                    <span class="text-muted">@Model.Profile.Email</span>
                </div>
                <div class="mb-3 pb-2 border-bottom">
                    <span class="text-muted small d-block">رقم الهاتف</span>
                    <span>@(string.IsNullOrEmpty(Model.Profile.PhoneNumber) ? "غير متوفر" : Model.Profile.PhoneNumber)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Profile.NationalIdOrTaxNumber))
                {
                    <div class="mb-3 pb-2 border-bottom">
                        <span class="text-muted small d-block">رقم الهوية الوطنية / السجل الضريبي</span>
                        <code class="bg-light p-1 rounded">@Model.Profile.NationalIdOrTaxNumber</code>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Profile.Address))
                {
                    <div class="mb-3 pb-2 border-bottom">
                        <span class="text-muted small d-block">العنوان</span>
                        <span>@Model.Profile.Address</span>
                    </div>
                }
                <div>
                    <span class="text-muted small d-block">تاريخ التسجيل</span>
                    <span>@Model.Profile.MemberSinceUtc.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Properties Overview -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-buildings me-2 text-success"></i>عقاراتي المسجلة</span>
                <span class="badge badge-subtle-secondary">@Model.Properties.Count عقار مسجّل</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Properties.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-building-slash fs-1 d-block mb-2 text-secondary"></i>
                        لا توجد سجلات عقارية مرتبطة بحسابك حالياً.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>الرقم المرجعي والعنوان</th>
                                    <th>الموقع</th>
                                    <th>المساحة</th>
                                    <th>نوع الملكية</th>
                                    <th>الحالة</th>
                                    <th class="text-end">التفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Properties)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">
                                                <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="text-decoration-none text-primary">
                                                    @p.ReferenceNumber
                                                </a>
                                            </div>
                                            <div class="small text-muted">@p.Title (@(p.Type == PropertyType.Land ? "أرض" : "فيلا"))</div>
                                        </td>
                                        <td>@p.DistrictOrArea، @p.City</td>
                                        <td>@p.AreaMeasurement.ToString("N0") @p.AreaUnit</td>
                                        <td>
                                            <span class="badge badge-subtle-primary">
                                                @p.OwnershipRole
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-subtle-secondary">@p.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-1 px-3">
                                                <span>عرض</span>
                                                <i class="bi bi-arrow-left"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Approved Procedures Tracking -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-clipboard2-check me-2 text-info"></i>متابعة مسار المعاملات</span>
                <span class="badge badge-subtle-info">@Model.ApprovedProcedures.Count معاملة نشطة</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedProcedures.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-clipboard-x fs-2 d-block mb-2 text-secondary"></i>
                        لا توجد معاملات نشطة مفعّلة للمتابعة بحسابك حالياً.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var pr in Model.ApprovedProcedures)
                        {
                            <div class="list-group-item p-3 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge badge-subtle-primary me-1">@pr.TypeLabel</span>
                                        <strong class="text-dark">@pr.PropertyReferenceNumber</strong>
                                    </div>
                                    <partial name="_ProcedureStatusBadge" model="pr.Status" />
                                </div>
                                <div class="small text-muted mb-2">
                                    الجهة: @(pr.ResponsibleAuthority ?? "جهة رسمية") &bull;
                                    @(pr.SubmissionDate.HasValue ? $"تاريخ التقديم: {pr.SubmissionDate.Value:yyyy-MM-dd}" : string.Empty)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(pr.CustomerUpdateNotes))
                                {
                                    <div class="p-2 rounded bg-light border-start border-3 border-info small mb-2">
                                        <i class="bi bi-info-circle text-info me-1"></i>
                                        <strong>آخر تحديث:</strong> @pr.CustomerUpdateNotes
                                    </div>
                                }
                                <div class="text-end">
                                    <a asp-action="ProcedureDetails" asp-route-id="@pr.Id" class="btn btn-sm btn-outline-info py-1 px-3">
                                        <span>تفاصيل الحالة</span>
                                        <i class="bi bi-arrow-left"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Approved Documents -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-file-earmark-arrow-down me-2 text-success"></i>المستندات والصكوك المعتمدة</span>
                <span class="badge badge-subtle-success">@Model.ApprovedDocuments.Count مستند متاح</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedDocuments.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-folder-check fs-2 d-block mb-2 text-secondary"></i>
                        لا توجد مستندات معتمدة متاحة للتحميل حالياً.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>عنوان المستند</th>
                                    <th>النوع</th>
                                    <th>الحجم</th>
                                    <th class="text-end">تحميل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.ApprovedDocuments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@doc.Title</div>
                                            <div class="small text-muted">@doc.OriginalFileName</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@doc.DocumentType</span></td>
                                        <td class="small text-muted">@doc.FormattedFileSize</td>
                                        <td class="text-end">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-success py-1 px-3 shadow-xs">
                                                <i class="bi bi-download me-1"></i> تحميل
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
