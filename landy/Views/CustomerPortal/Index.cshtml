@model Ardak.Application.DTOs.CustomerPortalDashboardDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "بوابة العميل";
}

<!-- ══ WELCOME HEADER ════════════════════════════════════════ -->
<div class="portal-welcome-header fade-in mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="portal-avatar">
            <i class="bi bi-person"></i>
        </div>
        <div style="position:relative;z-index:1;">
            <h1 class="h3 fw-800 mb-1" style="color:#fff;">مرحباً، @Model.Profile.FullName</h1>
            <p class="mb-0" style="color:rgba(255,255,255,0.65);font-size:0.9rem;">
                بوابة عملاء أرضك &mdash; استعراض سجلاتك العقارية ومتابعة مسار المعاملات
            </p>
        </div>
        <div class="me-auto" style="position:relative;z-index:1;">
            <span class="badge-subtle-success badge px-3 py-2 shadow-sm">
                <i class="bi bi-shield-check me-1"></i>حساب موثّق ومعتمد
            </span>
        </div>
    </div>
</div>

<!-- ══ STATS ROW ══════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="metric-card card-primary">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">عقاراتي</div>
                    <div class="metric-value">@Model.Properties.Count</div>
                </div>
                <div class="metric-icon-box icon-box-primary">
                    <i class="bi bi-buildings"></i>
                </div>
            </div>
            <div class="pt-2 border-top">
                <a asp-action="Properties" class="btn btn-sm btn-light py-1 px-3 text-primary" style="font-size:0.82rem;">
                    <span>عرض الكل</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="metric-card card-emerald">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">المعاملات النشطة</div>
                    <div class="metric-value">@Model.ApprovedProcedures.Count</div>
                </div>
                <div class="metric-icon-box icon-box-emerald">
                    <i class="bi bi-clipboard2-check"></i>
                </div>
            </div>
            <div class="pt-2 border-top">
                <span class="small" style="color:var(--text-muted);">قيد المتابعة</span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="metric-card card-cyan">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">المستندات المتاحة</div>
                    <div class="metric-value">@Model.ApprovedDocuments.Count</div>
                </div>
                <div class="metric-icon-box icon-box-cyan">
                    <i class="bi bi-file-earmark-arrow-down"></i>
                </div>
            </div>
            <div class="pt-2 border-top">
                <span class="small" style="color:var(--text-muted);">مستندات معتمدة</span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="metric-card card-gold">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">تاريخ الانضمام</div>
                    <div class="metric-value" style="font-size:1.4rem;">@Model.Profile.MemberSinceUtc.ToString("yyyy")</div>
                </div>
                <div class="metric-icon-box icon-box-gold">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <div class="pt-2 border-top">
                <span class="small" style="color:var(--text-muted);">@Model.Profile.MemberSinceUtc.ToString("dd MMM yyyy")</span>
            </div>
        </div>
    </div>
</div>

<!-- ══ MAIN CONTENT GRID ════════════════════════════════════ -->
<div class="row g-4">

    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-primary"></i>
                <span>الملف الشخصي</span>
            </div>
            <div class="card-body p-4">
                <!-- Avatar -->
                <div class="text-center mb-4">
                    <div style="width:72px;height:72px;background:var(--primary-light);border:2px solid var(--border-color);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:1.7rem;color:var(--primary);">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="fw-700 mt-2 text-dark">@Model.Profile.FullName</div>
                    <div class="small text-muted">
                        <code class="bg-light px-2 py-1 rounded" style="font-size:0.8rem;">#CUST-@Model.Profile.Id.ToString("D5")</code>
                    </div>
                </div>

                <div class="info-section-row">
                    <span class="info-lbl">البريد الإلكتروني</span>
                    <span class="info-val">@Model.Profile.Email</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">رقم الهاتف</span>
                    <span class="info-val font-monospace" dir="ltr">@(string.IsNullOrEmpty(Model.Profile.PhoneNumber) ? "غير متوفر" : Model.Profile.PhoneNumber)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Profile.NationalIdOrTaxNumber))
                {
                    <div class="info-section-row">
                        <span class="info-lbl">رقم الهوية</span>
                        <span class="info-val"><code class="bg-light px-2 py-1 rounded small">@Model.Profile.NationalIdOrTaxNumber</code></span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Profile.Address))
                {
                    <div class="info-section-row">
                        <span class="info-lbl">العنوان</span>
                        <span class="info-val">@Model.Profile.Address</span>
                    </div>
                }
                <div class="info-section-row">
                    <span class="info-lbl">تاريخ التسجيل</span>
                    <span class="info-val">@Model.Profile.MemberSinceUtc.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
            <div class="card-body border-top pt-3 pb-3">
                <a asp-action="Properties" class="btn btn-primary w-100 rounded-pill">
                    <i class="bi bi-buildings"></i>
                    <span>استعراض كل عقاراتي</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Properties Overview -->
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-buildings text-success"></i>
                    <strong>عقاراتي المسجلة</strong>
                </span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-subtle-secondary badge">@Model.Properties.Count عقار</span>
                    <a asp-action="Properties" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size:0.82rem;">
                        <span>عرض الكل</span>
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!Model.Properties.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-building-slash"></i>
                        <h6>لا توجد عقارات مسجلة</h6>
                        <p>لم يتم ربط أي عقارات بحسابك حتى الآن. للتواصل يرجى مراجعة إدارة النظام.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>الرقم المرجعي والعنوان</th>
                                    <th>الموقع</th>
                                    <th>المساحة</th>
                                    <th>الصفة</th>
                                    <th>الحالة</th>
                                    <th class="text-end">تفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Properties)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-700 text-dark">@p.Title</div>
                                            <div class="small font-monospace" style="color:var(--text-light);">@p.ReferenceNumber</div>
                                            <span class="badge @(p.Type == PropertyType.Land ? "badge-subtle-secondary" : "badge-subtle-primary") mt-1">
                                                @(p.Type == PropertyType.Land ? "أرض" : "فيلا")
                                            </span>
                                        </td>
                                        <td class="small text-muted">@p.DistrictOrArea، @p.City</td>
                                        <td class="font-monospace small">@p.AreaMeasurement.ToString("N0") @p.AreaUnit</td>
                                        <td><span class="badge-subtle-primary badge">@p.OwnershipRole</span></td>
                                        <td><span class="badge-subtle-secondary badge">@p.Status</span></td>
                                        <td class="text-end">
                                            <a asp-action="PropertyDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                                <span>عرض</span>
                                                <i class="bi bi-arrow-left"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Procedures Tracking -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard2-check text-info"></i>
                    <strong>متابعة المعاملات</strong>
                </span>
                <span class="badge-subtle-info badge">@Model.ApprovedProcedures.Count معاملة</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedProcedures.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-clipboard-x"></i>
                        <h6>لا توجد معاملات نشطة</h6>
                        <p>لا توجد معاملات نشطة مفعّلة للمتابعة بحسابك حالياً.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var pr in Model.ApprovedProcedures)
                        {
                            <div class="list-group-item p-3 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge-subtle-primary badge me-1">@pr.TypeLabel</span>
                                        <strong class="text-dark small">@pr.PropertyReferenceNumber</strong>
                                    </div>
                                    <partial name="_ProcedureStatusBadge" model="pr.Status" />
                                </div>
                                <div class="small text-muted mb-2">
                                    الجهة: @(pr.ResponsibleAuthority ?? "جهة رسمية")
                                    @if (pr.SubmissionDate.HasValue)
                                    {
                                        <span>&bull; @pr.SubmissionDate.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(pr.CustomerUpdateNotes))
                                {
                                    <div class="p-2 rounded-2 small mb-2" style="background:var(--cyan-light);border-right:3px solid var(--cyan);">
                                        <i class="bi bi-info-circle text-info me-1"></i>
                                        <strong>آخر تحديث:</strong> @pr.CustomerUpdateNotes
                                    </div>
                                }
                                <div class="text-end">
                                    <a asp-action="ProcedureDetails" asp-route-id="@pr.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                        <span>تفاصيل الحالة</span>
                                        <i class="bi bi-arrow-left"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Approved Documents -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-arrow-down text-success"></i>
                    <strong>المستندات المعتمدة</strong>
                </span>
                <span class="badge-subtle-success badge">@Model.ApprovedDocuments.Count مستند</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.ApprovedDocuments.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-folder-check"></i>
                        <h6>لا توجد مستندات متاحة</h6>
                        <p>لا توجد مستندات معتمدة متاحة للتحميل حالياً.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>المستند</th>
                                    <th>النوع</th>
                                    <th>الحجم</th>
                                    <th class="text-end">تحميل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.ApprovedDocuments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-700 text-dark small">
                                                <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                                @doc.Title
                                            </div>
                                            <div class="small font-monospace" style="color:var(--text-light);font-size:0.75rem;">@doc.OriginalFileName</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border small">@doc.DocumentType</span></td>
                                        <td class="small text-muted font-monospace">@doc.FormattedFileSize</td>
                                        <td class="text-end">
                                            <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-success rounded-pill px-3 py-1">
                                                <i class="bi bi-download"></i>
                                                <span>تحميل</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
