@{
    ViewData["Title"] = "نظام أرضك العقاري";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-8 text-center">
        <div class="ardak-logo-icon mx-auto mb-4" style="width: 72px; height: 72px; font-size: 2.2rem; border-radius: 20px;">
            <i class="bi bi-buildings"></i>
        </div>
        <h1 class="display-5 fw-bold mb-3">أهلاً بك في نظام <span class="text-primary">أرضك</span> لإدارة العقارات</h1>
        <p class="lead text-muted mb-4">
            المنصة الداخلية الرائدة لإدارة السجلات العقارية، صكوك الملكية، ومسار الإجراءات والمعاملات الرسمية
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="InternalDashboard" asp-action="Index" class="btn btn-primary btn-lg rounded-pill shadow px-4">
                <i class="bi bi-speedometer2 me-1"></i>
                <span>لوحة التحكم الإدارية</span>
            </a>
            <a asp-controller="CustomerPortal" asp-action="Index" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                <i class="bi bi-person-badge me-1"></i>
                <span>بوابة العميل</span>
            </a>
        </div>
    </div>
</div>
