@model CreateCustomerAccountDto
@{
    ViewData["Title"] = "إنشاء حساب بوابة العميل";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="InternalDashboard" asp-action="Index" class="text-decoration-none">لوحة التحكم</a></li>
        <li class="breadcrumb-item"><a asp-controller="Customers" asp-action="Index" class="text-decoration-none">العملاء</a></li>
        <li class="breadcrumb-item active text-muted">إنشاء حساب البوابة</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="feature-icon bg-info-subtle text-info p-2 rounded-3">
                        <i class="bi bi-person-badge-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">إنشاء حساب وصول لبوابة العميل</h5>
                        <small class="text-muted">تمكين العميل من متابعة عقاراته ومعاملاته ذاتياً</small>
                    </div>
                </div>
                <a asp-controller="InternalDashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-arrow-right"></i>
                    <span>العودة</span>
                </a>
            </div>

            <div class="card-body p-4">
                <div class="p-3 bg-light rounded-3 mb-4 border d-flex align-items-center gap-3">
                    <i class="bi bi-person-check fs-2 text-primary"></i>
                    <div>
                        <div class="text-muted small">العميل المستهدف:</div>
                        <strong class="text-dark fs-6">@ViewBag.CustomerName</strong>
                        <div class="text-muted small mt-1">
                            <span class="badge bg-secondary-subtle text-secondary font-monospace">رقم المعرّف: @Model.CustomerId</span>
                            <span class="badge bg-info-subtle text-info me-1">صلاحية بوابة العملاء (Customer)</span>
                        </div>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div>@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
                    </div>
                }

                <form asp-action="Provision" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold small text-muted">البريد الإلكتروني لتسجيل الدخول <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control font-monospace" type="email" placeholder="client@example.com" required dir="ltr" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small text-muted">كلمة المرور المؤقتة <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control font-monospace" type="password" placeholder="••••••••" required dir="ltr" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            يجب أن لا تقل عن 8 أحرف وتحتوي على حرف كبير ورقم واحد على الأقل.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small text-muted">تأكيد كلمة المرور <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control font-monospace" type="password" placeholder="••••••••" required dir="ltr" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="InternalDashboard" asp-action="Index" class="btn btn-light rounded-pill px-4 text-muted">إلغاء</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-person-check-fill me-1"></i>
                            <span>تفعيل الحساب وتعيين الصلاحيات</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
