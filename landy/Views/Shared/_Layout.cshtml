@inject Ardak.Application.Interfaces.ICurrentUserService CurrentUser
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - أرضك | ARDAK Real Estate</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Cinzel:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/landy.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- ══ ELITE LUXURY NAVBAR ════════════════════════════════════ -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark ardak-navbar">
            <div class="container-fluid px-lg-4 px-3">
                <!-- Brand Crest -->
                <a class="ardak-brand" asp-controller="Home" asp-action="Index">
                    <div class="ardak-brand-emblem">
                        <i class="bi bi-buildings"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-baseline">
                            <span class="ardak-brand-title">أرضك</span>
                            <span class="ardak-brand-sep">/</span>
                            <span class="ardak-brand-en">ARDAK</span>
                        </div>
                        <span class="ardak-brand-sub">إدارة العقارات والاستثمار الفاخر</span>
                    </div>
                </a>

                <!-- Mobile Toggler -->
                <button class="navbar-toggler border-0 shadow-none p-2" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <!-- Navigation Destinations -->
                <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 px-lg-3">
                        @if (CurrentUser.IsAuthenticated)
                        {
                            @if (CurrentUser.IsSuperAdmin || CurrentUser.IsAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="InternalDashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i>
                                        <span>لوحة التحكم</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="Properties" asp-action="Index">
                                        <i class="bi bi-houses"></i>
                                        <span>العقارات</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="Customers" asp-action="Index">
                                        <i class="bi bi-people"></i>
                                        <span>العملاء</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="Procedures" asp-action="Index">
                                        <i class="bi bi-file-earmark-check"></i>
                                        <span>المعاملات</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="Documents" asp-action="Index">
                                        <i class="bi bi-folder2-open"></i>
                                        <span>المستندات</span>
                                    </a>
                                </li>
                            }
                            @if (CurrentUser.IsSuperAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" style="color: #fca5a5 !important;" asp-controller="AdminManagement" asp-action="Index">
                                        <i class="bi bi-shield-lock" style="color: #fca5a5 !important;"></i>
                                        <span>المشرفين</span>
                                    </a>
                                </li>
                            }
                            @if (CurrentUser.IsCustomer)
                            {
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="CustomerPortal" asp-action="Index">
                                        <i class="bi bi-person-badge"></i>
                                        <span>بوابة العميل</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ardak-nav-item" asp-controller="CustomerPortal" asp-action="Properties">
                                        <i class="bi bi-buildings"></i>
                                        <span>عقاراتي</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- User Account / Logout Actions -->
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (CurrentUser.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <div class="user-status-pill">
                                    <div class="user-avatar-initials">
                                        @(CurrentUser.IsSuperAdmin ? "SA" : (CurrentUser.IsAdmin ? "AD" : "CU"))
                                    </div>
                                    <div class="d-flex flex-column text-end" style="line-height: 1.2;">
                                        <span class="small fw-bold text-white font-monospace">@CurrentUser.Email</span>
                                        <div class="mt-1">
                                            @if (CurrentUser.IsSuperAdmin)
                                            {
                                                <span class="badge py-0 px-2" style="background: rgba(192, 43, 45, 0.3); color: #fca5a5; font-size: 0.68rem; border: 1px solid rgba(252, 165, 165, 0.3);">مشرف عام</span>
                                            }
                                            else if (CurrentUser.IsAdmin)
                                            {
                                                <span class="badge py-0 px-2" style="background: rgba(16, 147, 115, 0.3); color: #6ee7b7; font-size: 0.68rem; border: 1px solid rgba(110, 231, 183, 0.3);">مشرف</span>
                                            }
                                            else if (CurrentUser.IsCustomer)
                                            {
                                                <span class="badge py-0 px-2" style="background: rgba(18, 125, 168, 0.3); color: #7dd3fc; font-size: 0.68rem; border: 1px solid rgba(125, 211, 252, 0.3);">عميل موثق</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm px-3 rounded-pill" title="تسجيل الخروج">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>خروج</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-success rounded-pill px-4 shadow-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-left"></i>
                                    <span>تسجيل الدخول</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ══ MAIN VIEW CANVAS ═════════════════════════════════════ -->
    <div class="container-fluid px-lg-4 px-3 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ══ REFINED FOOTER ═══════════════════════════════════════ -->
    <footer class="ardak-footer mt-auto">
        <div class="container-fluid px-lg-4 px-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="ardak-brand-emblem" style="width: 28px; height: 28px; font-size: 0.85rem; border-radius: 6px;">
                    <i class="bi bi-buildings"></i>
                </div>
                <span>&copy; @DateTime.UtcNow.Year &mdash; منصة أرضك | نظام إدارة واستثمار العقارات والمعاملات الرسمية</span>
            </div>
            <div class="d-flex align-items-center gap-3 small" style="color: rgba(255, 255, 255, 0.45);">
                <span><i class="bi bi-shield-lock-fill text-success me-1"></i>نظام إلكتروني مشفّر 256-bit</span>
                <span>&bull;</span>
                <span>المملكة العربية السعودية</span>
            </div>
        </div>
    </footer>

    <!-- ══ SCRIPTS ══════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
