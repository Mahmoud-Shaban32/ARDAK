@model Ardak.Model.Enums.ProcedureStatus
@{
    var (badgeClass, icon, label) = Model switch
    {
        Ardak.Model.Enums.ProcedureStatus.Submitted => 
            ("badge-subtle-secondary", "bi-send", "مُقدَّم"),
        Ardak.Model.Enums.ProcedureStatus.InProgress => 
            ("badge-subtle-primary", "bi-arrow-repeat", "قيد الإجراء"),
        Ardak.Model.Enums.ProcedureStatus.PendingRequirements => 
            ("badge-subtle-warning", "bi-exclamation-circle", "بانتظار متطلبات"),
        Ardak.Model.Enums.ProcedureStatus.UnderReview => 
            ("badge-subtle-info", "bi-search", "قيد المراجعة"),
        Ardak.Model.Enums.ProcedureStatus.Approved => 
            ("badge-subtle-success", "bi-check-circle", "معتمد"),
        Ardak.Model.Enums.ProcedureStatus.Rejected => 
            ("badge-subtle-danger", "bi-x-circle", "مرفوض"),
        Ardak.Model.Enums.ProcedureStatus.Completed => 
            ("badge-subtle-success", "bi-check-all", "مكتمل"),
        Ardak.Model.Enums.ProcedureStatus.Cancelled => 
            ("badge-subtle-secondary", "bi-slash-circle", "ملغى"),
        _ => 
            ("badge-subtle-secondary", "bi-dash-circle", Model.ToString())
    };
}
<span class="badge @badgeClass d-inline-flex align-items-center gap-1">
    <i class="bi @icon"></i>
    <span>@label</span>
</span>
