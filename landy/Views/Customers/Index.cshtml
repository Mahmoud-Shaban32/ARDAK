@model IReadOnlyList<CustomerSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "إدارة العملاء";
    string? currentSearch = ViewBag.SearchTerm as string;
    CustomerStatus? currentStatus = ViewBag.Status as CustomerStatus?;
    bool hasFilter = !string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue;
}

<!-- ══ PAGE HEADER ════════════════════════════════════════════ -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3 fade-in">
    <div>
        <h2 class="h3 fw-800 mb-1">
            <i class="bi bi-people text-primary me-2"></i>إدارة العملاء
        </h2>
        <p class="text-muted mb-0 small">سجل العملاء والمستفيدين &mdash; وصول الموظفين المصرح لهم فقط</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-person-plus"></i>
        <span>تسجيل عميل جديد</span>
    </a>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ FILTER BAR ════════════════════════════════════════════ -->
<div class="filter-bar mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small">بحث</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" class="form-control"
                       placeholder="الاسم، رقم الهاتف أو البريد الإلكتروني..."
                       value="@currentSearch" />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small">الحالة</label>
            <select name="status" class="form-select">
                <option value="">جميع الحالات</option>
                @foreach (var val in Enum.GetValues<CustomerStatus>())
                {
                    var label = val switch {
                        CustomerStatus.Active => "نشط",
                        CustomerStatus.Inactive => "غير نشط",
                        CustomerStatus.Archived => "مؤرشف",
                        _ => val.ToString()
                    };
                    if (currentStatus == val)
                    {
                        <option value="@val" selected>@label</option>
                    }
                    else
                    {
                        <option value="@val">@label</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-funnel"></i>
                <span>تصفية</span>
            </button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="مسح الفلاتر">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>إعادة تعيين</span>
                </a>
            }
        </div>
    </form>
    @if (hasFilter)
    {
        <div class="mt-2 small text-muted">
            <i class="bi bi-funnel-fill text-primary me-1"></i>
            عرض <strong class="text-dark">@Model.Count</strong> نتيجة
        </div>
    }
</div>

<!-- ══ TABLE ═════════════════════════════════════════════════ -->
<div class="card border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>اسم العميل</th>
                    <th>رقم الهاتف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الحالة</th>
                    <th>العقارات</th>
                    <th>بوابة المستفيد</th>
                    <th>تاريخ التسجيل</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="bi bi-person-x"></i>
                                <h6>لا توجد سجلات عملاء</h6>
                                <p>لا توجد سجلات تطابق معايير البحث الحالية.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill mt-2">مسح فلاتر البحث</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@customer.Id"
                               class="text-decoration-none fw-700 text-primary">
                                @customer.FullName
                            </a>
                        </td>
                        <td dir="ltr" class="text-end font-monospace small">@customer.PhoneNumber</td>
                        <td class="small text-muted">@(string.IsNullOrEmpty(customer.Email) ? "—" : customer.Email)</td>
                        <td>
                            @switch (customer.Status)
                            {
                                case CustomerStatus.Active:
                                    <span class="badge badge-subtle-success">نشط</span>
                                    break;
                                case CustomerStatus.Inactive:
                                    <span class="badge badge-subtle-warning">غير نشط</span>
                                    break;
                                case CustomerStatus.Archived:
                                    <span class="badge badge-subtle-secondary">مؤرشف</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-houses me-1 text-primary"></i>
                                @customer.PropertyCount @(customer.PropertyCount == 1 ? "عقار" : "عقارات")
                            </span>
                        </td>
                        <td>
                            @if (customer.HasPortalAccount)
                            {
                                <span class="badge badge-subtle-success">
                                    <i class="bi bi-check2-circle me-1"></i>مفعّلة
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">غير مفعّل</span>
                            }
                        </td>
                        <td class="small text-muted">@customer.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@customer.Id"
                                   class="btn btn-sm btn-outline-primary py-1 px-2">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@customer.Id"
                                   class="btn btn-sm btn-outline-secondary py-1 px-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (customer.Status != CustomerStatus.Archived)
                                {
                                    <form asp-action="Archive" asp-route-id="@customer.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger py-1 px-2"
                                                onclick="return confirm('أرشفة سجل @customer.FullName؟ سيؤدي ذلك إلى تعطيل صلاحية البوابة.');">
                                            <i class="bi bi-archive"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
