@model IReadOnlyList<CustomerSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "إدارة العملاء";
    string? currentSearch = ViewBag.SearchTerm as string;
    CustomerStatus? currentStatus = ViewBag.Status as CustomerStatus?;
}

<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1">
            <i class="bi bi-people text-primary me-2"></i>إدارة العملاء
        </h2>
        <p class="text-muted mb-0 small">سجل العملاء والمستفيدين &mdash; وصول الموظفين المصرح لهم فقط</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-person-plus me-1"></i>
        <span>تسجيل عميل جديد</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- نموذج البحث والتصفية -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="بحث بالاسم أو رقم الهاتف أو البريد الإلكتروني..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">جميع الحالات</option>
                    @foreach (var val in Enum.GetValues<CustomerStatus>())
                    {
                        if (currentStatus == val)
                        {
                            <option value="@val" selected>
                                @(val == CustomerStatus.Active ? "نشط" : (val == CustomerStatus.Inactive ? "غير نشط" : "مؤرشف"))
                            </option>
                        }
                        else
                        {
                            <option value="@val">
                                @(val == CustomerStatus.Active ? "نشط" : (val == CustomerStatus.Inactive ? "غير نشط" : "مؤرشف"))
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-funnel"></i> تصفية
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> إعادة تعيين
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- جدول سجلات العملاء -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>اسم العميل</th>
                    <th>رقم الهاتف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الحالة</th>
                    <th>العقارات</th>
                    <th>بوابة المستفيد</th>
                    <th>تاريخ التسجيل</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            <p class="mb-1">لا توجد سجلات عملاء تطابق معايير البحث.</p>
                            @if (!string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue)
                            {
                                <a asp-action="Index" class="btn btn-sm btn-link">مسح فلاتر البحث</a>
                            }
                        </td>
                    </tr>
                }
                @foreach (var customer in Model)
                {
                    <tr>
                        <td class="fw-bold">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="text-decoration-none text-primary">
                                @customer.FullName
                            </a>
                        </td>
                        <td dir="ltr" class="text-end font-monospace">@customer.PhoneNumber</td>
                        <td>@(string.IsNullOrEmpty(customer.Email) ? "-" : customer.Email)</td>
                        <td>
                            @switch (customer.Status)
                            {
                                case CustomerStatus.Active:
                                    <span class="badge badge-subtle-success">نشط</span>
                                    break;
                                case CustomerStatus.Inactive:
                                    <span class="badge badge-subtle-warning">غير نشط</span>
                                    break;
                                case CustomerStatus.Archived:
                                    <span class="badge badge-subtle-secondary">مؤرشف</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-houses me-1 text-primary"></i>
                                @customer.PropertyCount @(customer.PropertyCount == 1 ? "عقار" : "عقارات")
                            </span>
                        </td>
                        <td>
                            @if (customer.HasPortalAccount)
                            {
                                <span class="badge badge-subtle-primary">
                                    <i class="bi bi-check2-circle me-1"></i>مفعّلة
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">غير مفعّل</span>
                            }
                        </td>
                        <td class="small text-muted">@customer.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary py-1 px-2 me-1">
                                <i class="bi bi-eye"></i> عرض
                            </a>
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1">
                                <i class="bi bi-pencil"></i> تعديل
                            </a>
                            @if (customer.Status != CustomerStatus.Archived)
                            {
                                <form asp-action="Archive" asp-route-id="@customer.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" onclick="return confirm('أرشفة سجل @customer.FullName؟ سيؤدي ذلك إلى تعطيل صلاحية البوابة.');">
                                        <i class="bi bi-archive"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
