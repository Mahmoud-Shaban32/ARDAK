@model CustomerDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"بيانات العميل - {Model.FullName}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">العملاء</a></li>
        <li class="breadcrumb-item active text-muted">@Model.FullName</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3 fade-in">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="h3 fw-800 mb-0">
                <i class="bi bi-person-circle text-primary me-2"></i>@Model.FullName
            </h1>
            @switch (Model.Status)
            {
                case CustomerStatus.Active:
                    <span class="badge badge-subtle-success">نشط</span>
                    break;
                case CustomerStatus.Inactive:
                    <span class="badge badge-subtle-warning">غير نشط</span>
                    break;
                case CustomerStatus.Archived:
                    <span class="badge badge-subtle-secondary">مؤرشف</span>
                    break;
            }
        </div>
        <p class="text-muted mb-0 small">
            الرقم المرجعي: <code class="bg-light px-2 py-1 rounded font-monospace">#CUST-@Model.Id.ToString("D5")</code> &bull; تاريخ الإنشاء: @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-pencil-square"></i>
            <span>تعديل البيانات</span>
        </a>
        @if (!Model.HasPortalAccount && Model.Status != CustomerStatus.Archived)
        {
            <a asp-controller="CustomerAccount" asp-action="Provision" asp-route-customerId="@Model.Id" class="btn btn-primary rounded-pill shadow-sm">
                <i class="bi bi-person-badge"></i>
                <span>إنشاء حساب للبوابة</span>
            </a>
        }
        @if (Model.Status == CustomerStatus.Archived)
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success rounded-pill">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>استعادة وتنشيط</span>
                </button>
            </form>
        }
        else
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger rounded-pill" onclick="return confirm('هل أنت متأكد من أرشفة سجل هذا العميل؟');">
                    <i class="bi bi-archive"></i>
                    <span>أرشفة</span>
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-right"></i>
            <span>القائمة</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- بيانات العميل والتواصل -->
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i>
                <span>بيانات العميل ومعلومات الاتصال</span>
            </div>
            <div class="card-body p-4">
                <div class="info-section-row">
                    <span class="info-lbl">الاسم الكامل</span>
                    <span class="info-val fw-700 text-dark">@Model.FullName</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">رقم الجوال</span>
                    <span class="info-val font-monospace" dir="ltr">@Model.PhoneNumber</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">البريد الإلكتروني</span>
                    <span class="info-val font-monospace" dir="ltr">@(string.IsNullOrEmpty(Model.Email) ? "غير متوفر" : Model.Email)</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">العنوان والمدينة</span>
                    <span class="info-val">@(string.IsNullOrEmpty(Model.Address) ? "غير متوفر" : Model.Address)</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">الهوية / الرقم الضريبي</span>
                    <span class="info-val font-monospace">@(string.IsNullOrEmpty(Model.NationalIdOrTaxNumber) ? "غير متوفر" : Model.NationalIdOrTaxNumber)</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">حالة الحساب</span>
                    <span class="info-val">
                        @switch (Model.Status)
                        {
                            case CustomerStatus.Active:
                                <span class="badge badge-subtle-success">نشط</span>
                                break;
                            case CustomerStatus.Inactive:
                                <span class="badge badge-subtle-warning">غير نشط</span>
                                break;
                            case CustomerStatus.Archived:
                                <span class="badge badge-subtle-secondary">مؤرشف</span>
                                break;
                        }
                    </span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">آخر تعديل</span>
                    <span class="info-val text-muted small">@(Model.ModifiedAtUtc.HasValue ? Model.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") : "لم يُعدّل بعد")</span>
                </div>
            </div>
        </div>

        <!-- العقارات المرتبطة -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 fw-700">
                    <i class="bi bi-houses text-success"></i>
                    <span>العقارات المرتبطة بالعميل</span>
                    <span class="badge badge-subtle-primary">@Model.PropertyCount</span>
                </div>
                <a asp-controller="Properties" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-plus-lg me-1"></i>
                    <span>إضافة عقار للعميل</span>
                </a>
            </div>
            <div class="card-body p-4">
                @if (Model.PropertyTitles.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var title in Model.PropertyTitles)
                        {
                            <div class="list-group-item d-flex align-items-center gap-2 px-0 py-2 border-bottom">
                                <i class="bi bi-building text-primary"></i>
                                <span class="fw-600 text-dark">@title</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-building-slash"></i>
                        <h6>لا توجد عقارات مسجلة</h6>
                        <p>لا توجد عقارات مسجلة مرتبطة بهذا العميل حالياً.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- العمود الأيسر: الملاحظات الداخلية وحساب البوابة -->
    <div class="col-lg-5">
        <!-- ملاحظات فريق العمل الداخلية (سرية) -->
        <div class="card internal-note-card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 fw-700 text-danger">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <span>ملاحظات فريق العمل الداخلية</span>
                </div>
                <span class="badge badge-subtle-danger">خاص وسري</span>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
                {
                    <p class="mb-0 text-dark" style="white-space: pre-wrap;">@Model.InternalNotes</p>
                }
                else
                {
                    <p class="text-muted mb-0 small">لا توجد ملاحظات داخلية مسجلة لهذا العميل.</p>
                }
                <div class="mt-3 text-muted small border-top pt-2">
                    <i class="bi bi-info-circle me-1"></i>
                    تنبيه: هذه الملاحظات مخصصة لفريق العمل الداخلي ولن تظهر للعميل في بوابته إطلاقاً.
                </div>
            </div>
        </div>

        <!-- حالة حساب بوابة العميل -->
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-info"></i>
                <span class="fw-700">حساب بوابة العميل الإلكترونية</span>
            </div>
            <div class="card-body p-4">
                @if (Model.HasPortalAccount)
                {
                    <div class="d-flex align-items-center mb-3 gap-2">
                        <span class="badge badge-subtle-success">
                            <i class="bi bi-check-circle me-1"></i>حساب مفعل
                        </span>
                        <span class="small text-muted font-monospace">@Model.IdentityUserId</span>
                    </div>
                    <p class="text-muted small mb-0">
                        العميل يمتلك حساب دخول مصرح به للبوابة، ويستطيع متابعة عقاراته ومعاملاته وتحميل المستندات المعتمدة ذاتياً.
                    </p>
                }
                else
                {
                    <div class="alert alert-light border mb-3">
                        <p class="small text-muted mb-0">لم يتم تفعيل أو إنشاء حساب بوابة إلكترونية لهذا العميل بعد.</p>
                    </div>
                    @if (Model.Status != CustomerStatus.Archived)
                    {
                        <a asp-controller="CustomerAccount" asp-action="Provision" asp-route-customerId="@Model.Id" class="btn btn-outline-primary rounded-pill w-100">
                            <i class="bi bi-key me-1"></i>
                            <span>تفعيل حساب وصول للبوابة</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>
