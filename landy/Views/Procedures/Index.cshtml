@model IReadOnlyList<Ardak.Application.DTOs.ProcedureSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "المعاملات";
    var filter = ViewBag.Filter as Ardak.Application.DTOs.ProcedureSearchFilterDto
                 ?? new Ardak.Application.DTOs.ProcedureSearchFilterDto();
    bool hasFilter = filter.Type.HasValue || filter.Status.HasValue || (filter.OverdueOnly == true);
}

<!-- ══ PAGE HEADER ════════════════════════════════════════════ -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3 fade-in">
    <div>
        <h2 class="h3 fw-800 mb-1">
            <i class="bi bi-file-earmark-check text-info me-2"></i>إدارة المعاملات والإجراءات
        </h2>
        <p class="text-muted mb-0 small">متابعة مسارات المعاملات لدى الدوائر الرسمية والجهات الحكومية والخاصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-circle me-1"></i>
        <span>إضافة معاملة جديدة</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ FILTER BAR ════════════════════════════════════════════ -->
<div class="filter-bar mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">نوع المعاملة</label>
            <select name="Type" asp-items="@ViewBag.ProcedureTypes" class="form-select">
                <option value="">جميع الأنواع</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">الحالة</label>
            <select name="Status" asp-items="@ViewBag.ProcedureStatuses" class="form-select">
                <option value="">جميع الحالات</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check pb-2">
                <input class="form-check-input" type="checkbox" name="OverdueOnly" value="true"
                       @(filter.OverdueOnly == true ? "checked" : "") id="chkOverdue">
                <label class="form-check-label small fw-bold text-danger" for="chkOverdue">
                    <i class="bi bi-exclamation-circle me-1"></i>المتأخرة فقط
                </label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-funnel"></i> تصفية
            </button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="مسح الفلاتر">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- ══ TABLE ═════════════════════════════════════════════════ -->
@if (!Model.Any())
{
    <div class="card border-0 py-5 text-center text-muted">
        <div class="empty-state">
            <i class="bi bi-clipboard2-x"></i>
            <h6>لا توجد معاملات مسجلة مطابقة</h6>
            <p class="mb-3">لم يتم العثور على أي معاملات تطابق معايير البحث.</p>
            <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-4 mx-auto">إنشاء أول معاملة</a>
        </div>
    </div>
}
else
{
    <div class="card border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>النوع</th>
                        <th>العقار المرتبط</th>
                        <th>رقم الطلب</th>
                        <th>الجهة المسؤولة</th>
                        <th>الحالة</th>
                        <th>الموعد القادم</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge badge-subtle-primary">@p.TypeLabel</span>
                            </td>
                            <td>
                                <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId"
                                   class="text-decoration-none fw-700 text-primary font-monospace small">
                                    @p.PropertyReferenceNumber
                                </a>
                                <div class="small text-muted">@p.PropertyTitle</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(p.ApplicationNumber))
                                {
                                    <code class="bg-light p-1 rounded font-monospace small">@p.ApplicationNumber</code>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="small">
                                <span class="badge bg-light text-dark border">
                                    @(p.ResponsibleAuthority ?? "—")
                                </span>
                            </td>
                            <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                            <td>
                                @if (p.NextActionDeadline.HasValue)
                                {
                                    var cssClass = p.HasOverdueDeadline ? "text-danger fw-700" : "text-body";
                                    <span class="@cssClass small">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @p.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                        @if (p.HasOverdueDeadline)
                                        {
                                            <span class="badge bg-danger ms-1">متأخر</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-outline-secondary py-1 px-2">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-outline-primary py-1 px-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-2 px-3 text-muted small d-flex justify-content-between align-items-center">
            <span>إجمالي المعاملات: <strong class="text-dark">@Model.Count</strong> معاملة</span>
        </div>
    </div>
}
