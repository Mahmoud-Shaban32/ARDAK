@model Ardak.Application.DTOs.CreateProcedureDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "إضافة معاملة جديدة";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المعاملات</a></li>
        <li class="breadcrumb-item active text-muted">إضافة معاملة جديدة</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-clipboard2-plus text-primary me-2"></i>إضافة معاملة جديدة
        </h1>
        <p class="text-muted mb-0 small">تسجيل معاملة رسمية جديدة وربطها بالعقار والجهات المعنية</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-right"></i>
        <span>العودة للمعاملات</span>
    </a>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- 1. العقار والتصنيف -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-houses text-primary fs-5"></i>
                    <span>بيانات العقار وتصنيف المعاملة</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="PropertyId" class="form-label fw-bold small text-muted">العقار المرتبط <span class="text-danger">*</span></label>
                        <select asp-for="PropertyId" asp-items="@ViewBag.Properties" class="form-select">
                            <option value="">— اختر العقار المرتبط —</option>
                        </select>
                        <span asp-validation-for="PropertyId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-bold small text-muted">نوع المعاملة <span class="text-danger">*</span></label>
                        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ProcedureType>()" class="form-select" id="selType"></select>
                        <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3" id="typeLabelRow">
                        <label asp-for="TypeLabel" class="form-label fw-bold small text-muted">مسمى المعاملة المخصص (عند اختيار أخرى)</label>
                        <input asp-for="TypeLabel" class="form-control" placeholder="مثال: فحص مساحي خاص" />
                        <span asp-validation-for="TypeLabel" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ApplicationNumber" class="form-label fw-bold small text-muted">رقم الطلب / المعاملة لدى الجهة</label>
                        <input asp-for="ApplicationNumber" class="form-control font-monospace" placeholder="مثال: APP-2026-904" />
                        <span asp-validation-for="ApplicationNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ResponsibleAuthority" class="form-label fw-bold small text-muted">الجهة أو الدائرة المسؤولة</label>
                        <input asp-for="ResponsibleAuthority" class="form-control" placeholder="مثال: وزارة العدل / أمانة المنطقة / منصة بلدي" />
                        <span asp-validation-for="ResponsibleAuthority" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. الحالة والجدول الزمني -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-info fs-5"></i>
                    <span>حالة المعاملة والجدول الزمني</span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold small text-muted">الحالة الحالية</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProcedureStatus>()" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SubmissionDate" class="form-label fw-bold small text-muted">تاريخ التقديم</label>
                            <input asp-for="SubmissionDate" type="date" class="form-control" />
                            <span asp-validation-for="SubmissionDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NextActionDeadline" class="form-label fw-bold small text-muted">موعد الإجراء القادم</label>
                            <input asp-for="NextActionDeadline" type="date" class="form-control" />
                            <span asp-validation-for="NextActionDeadline" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NextActionDescription" class="form-label fw-bold small text-muted">وصف الإجراء أو المهمة المطلوبة</label>
                        <textarea asp-for="NextActionDescription" class="form-control" rows="2" placeholder="مثال: مراجعة الدائرة القضائية لاستلام الصك النهائي"></textarea>
                        <span asp-validation-for="NextActionDescription" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MissingDocuments" class="form-label fw-bold small text-muted">المستندات أو المتطلبات الناقصة</label>
                        <textarea asp-for="MissingDocuments" class="form-control" rows="3" placeholder="سرد المستندات والشهادات المطلوبة إن وجدت..."></textarea>
                        <span asp-validation-for="MissingDocuments" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. التكاليف والبيانات المالية -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-cash-coin text-success fs-5"></i>
                    <span>المتابعة المالية (للموظفين داخلياً)</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TotalFee" class="form-label fw-bold small text-muted">إجمالي الرسوم / التكلفة</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">ريال</span>
                                <input asp-for="TotalFee" type="number" step="0.01" min="0" class="form-control font-monospace" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="TotalFee" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AmountPaid" class="form-label fw-bold small text-muted">المبلغ المدفوع</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">ريال</span>
                                <input asp-for="AmountPaid" type="number" step="0.01" min="0" class="form-control font-monospace" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="AmountPaid" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. ملاحظات داخلية سرية -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2 text-danger">
                    <i class="bi bi-shield-lock fs-5"></i>
                    <span>ملاحظات داخلية (سري للغاية)</span>
                </div>
                <div class="card-body">
                    <label asp-for="InternalNotes" class="form-label fw-bold small text-muted">ملاحظات فريق العمل الداخلي</label>
                    <textarea asp-for="InternalNotes" class="form-control" rows="4" placeholder="ملاحظات سرية مخصصة لفريق العمل فقط &mdash; لا تظهر للمستفيد إطلاقاً..."></textarea>
                    <span asp-validation-for="InternalNotes" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <!-- 5. إعدادات رؤية العميل وتحديثاته -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2 text-primary">
                    <i class="bi bi-eye fs-5"></i>
                    <span>إعدادات إتاحة المتابعة للعميل</span>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsCustomerVisible" class="form-check-input" type="checkbox" id="chkCustVisible" />
                        <label class="form-check-label fw-bold" for="chkCustVisible">
                            إتاحة ظهور حالة هذه المعاملة في بوابة العميل
                        </label>
                        <div class="text-muted small mt-1">
                            بشكل افتراضي تكون المعاملات خاصة. قم بتفعيل هذا الخيار فقط عندما يُسمح للعميل بمتابعة تحديثات المعاملة عبر بوابته.
                        </div>
                    </div>
                    
                    <div class="mb-2">
                        <label asp-for="CustomerUpdateNotes" class="form-label fw-bold small text-muted">رسالة التحديث الموجهة للعميل (إن وجدت)</label>
                        <textarea asp-for="CustomerUpdateNotes" class="form-control" rows="3" placeholder="ملاحظات موجهة للمستفيد (مثال: تم إرسال المعاملة للدراسة المساحية ومن المتوقع صدور التقرير قريباً)..."></textarea>
                        <span asp-validation-for="CustomerUpdateNotes" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Buttons -->
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill shadow">
            <i class="bi bi-check2-circle"></i>
            <span>حفظ وإنشاء المعاملة</span>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">إلغاء</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const selType = document.getElementById('selType');
        const typeLabelRow = document.getElementById('typeLabelRow');

        function toggleTypeLabel() {
            // ProcedureType.Other == 99
            typeLabelRow.style.display = selType.value == '99' ? '' : 'none';
        }

        selType.addEventListener('change', toggleTypeLabel);
        toggleTypeLabel();
    </script>
}
