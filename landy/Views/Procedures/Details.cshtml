@model Ardak.Application.DTOs.ProcedureDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تفاصيل المعاملة – {Model.TypeLabel}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المعاملات</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none">
                @Model.PropertyReferenceNumber
            </a>
        </li>
        <li class="breadcrumb-item active text-muted">@Model.TypeLabel</li>
    </ol>
</nav>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Page Header -->
<div class="page-header-box d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="h3 fw-bold mb-0">
                <i class="bi bi-clipboard2-check text-primary me-1"></i>@Model.TypeLabel
            </h1>
            <partial name="_ProcedureStatusBadge" model="Model.Status" />
        </div>
        <p class="text-muted mb-0 small">
            العقار المرتبط:
            <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none fw-bold text-primary">
                @Model.PropertyReferenceNumber &ndash; @Model.PropertyTitle
            </a>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill shadow-sm">
            <i class="bi bi-pencil me-1"></i> تعديل المعاملة
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-right"></i> القائمة
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- 1. البيانات الأساسية -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary fs-5"></i>
                <span>البيانات الأساسية للمسار</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">نوع المعاملة</dt>
                    <dd class="col-sm-7 fw-bold">@Model.TypeLabel</dd>

                    <dt class="col-sm-5 text-muted small">رقم الطلب / المرجع</dt>
                    <dd class="col-sm-7 font-monospace">@(Model.ApplicationNumber ?? "—")</dd>

                    <dt class="col-sm-5 text-muted small">الجهة المسؤولة</dt>
                    <dd class="col-sm-7">@(Model.ResponsibleAuthority ?? "—")</dd>

                    <dt class="col-sm-5 text-muted small">تاريخ التقديم</dt>
                    <dd class="col-sm-7">
                        @(Model.SubmissionDate.HasValue ? Model.SubmissionDate.Value.ToString("yyyy-MM-dd") : "—")
                    </dd>

                    <dt class="col-sm-5 text-muted small">موعد الإجراء القادم</dt>
                    <dd class="col-sm-7">
                        @if (Model.NextActionDeadline.HasValue)
                        {
                            var css = Model.HasOverdueDeadline ? "text-danger fw-bold" : string.Empty;
                            <span class="@css">
                                @Model.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                @if (Model.HasOverdueDeadline)
                                {
                                    <span class="badge bg-danger ms-1">متأخر</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(Model.NextActionDescription))
                    {
                        <dt class="col-sm-5 text-muted small">الإجراء المطلوب</dt>
                        <dd class="col-sm-7 text-dark fw-semibold">@Model.NextActionDescription</dd>
                    }

                    <dt class="col-sm-5 text-muted small">تاريخ الإنشاء</dt>
                    <dd class="col-sm-7 small text-muted">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</dd>

                    @if (Model.ModifiedAtUtc.HasValue)
                    {
                        <dt class="col-sm-5 text-muted small">آخر تحديث</dt>
                        <dd class="col-sm-7 small text-muted">@Model.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <!-- 2. المتابعة المالية -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-cash-coin text-success fs-5"></i>
                <span>المتابعة المالية والتكاليف</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">إجمالي التكلفة / الرسوم</dt>
                    <dd class="col-sm-7 font-monospace fw-bold">
                        @(Model.TotalFee.HasValue ? $"{Model.TotalFee:N2} ريال" : "—")
                    </dd>

                    <dt class="col-sm-5 text-muted small">المبلغ المدفوع</dt>
                    <dd class="col-sm-7 font-monospace text-success fw-bold">
                        @(Model.AmountPaid.HasValue ? $"{Model.AmountPaid:N2} ريال" : "—")
                    </dd>

                    <dt class="col-sm-5 text-muted small">المتبقي المطلوب</dt>
                    <dd class="col-sm-7 font-monospace">
                        @if (Model.BalanceDue.HasValue)
                        {
                            var balCss = Model.BalanceDue.Value > 0 ? "text-danger fw-bold" : "text-success fw-bold";
                            <span class="@balCss">@Model.BalanceDue.Value.ToString("N2") ريال</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- 3. المستندات الناقصة إن وجدت -->
    @if (!string.IsNullOrWhiteSpace(Model.MissingDocuments))
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 border-start border-4 border-warning">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2 text-warning-emphasis">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
                    <span>المستندات والمتطلبات الناقصة المطلوبة</span>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-dark" style="white-space: pre-wrap;">@Model.MissingDocuments</p>
                </div>
            </div>
        </div>
    }

    <!-- 4. ملاحظات داخلية سرية -->
    @if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 border-start border-4 border-danger">
                <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2 text-danger">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <span>ملاحظات داخلية لفريق العمل (سري)</span>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.InternalNotes</p>
                </div>
            </div>
        </div>
    }

    <!-- 5. سجل تحديثات وتاريخ الحالة -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary fs-5"></i>
                <span>سجل حركة الحالة وتاريخ المعاملة</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.StatusHistory.Any())
                {
                    <p class="text-muted p-4 mb-0 text-center">لا توجد حركات سابقة مسجلة على هذه المعاملة.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>التاريخ (UTC)</th>
                                    <th>من حالة</th>
                                    <th>إلى حالة</th>
                                    <th>ملحوظة التغيير</th>
                                    <th>المستخدم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.StatusHistory)
                                {
                                    <tr>
                                        <td class="text-nowrap small font-monospace">@h.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><partial name="_ProcedureStatusBadge" model="h.FromStatus" /></td>
                                        <td><partial name="_ProcedureStatusBadge" model="h.ToStatus" /></td>
                                        <td>@(h.ChangeNote ?? "—")</td>
                                        <td class="text-muted small">@(h.ChangedByUserId ?? "النظام")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
