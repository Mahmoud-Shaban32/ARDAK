@model Ardak.Application.DTOs.ProcedureDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تفاصيل المعاملة – {Model.TypeLabel}";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المعاملات</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none font-monospace">
                @Model.PropertyReferenceNumber
            </a>
        </li>
        <li class="breadcrumb-item active text-muted">@Model.TypeLabel</li>
    </ol>
</nav>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ PAGE HEADER ════════════════════════════════════════════ -->
<div class="page-header-box d-flex justify-content-between align-items-start flex-wrap gap-3 fade-in">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="h3 fw-800 mb-0">
                <i class="bi bi-clipboard2-check text-primary me-1"></i>@Model.TypeLabel
            </h1>
            <partial name="_ProcedureStatusBadge" model="Model.Status" />
        </div>
        <p class="text-muted mb-0 small">
            العقار المرتبط:
            <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none fw-700 text-primary">
                @Model.PropertyReferenceNumber &ndash; @Model.PropertyTitle
            </a>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill shadow-sm">
            <i class="bi bi-pencil"></i>
            <span>تعديل المعاملة</span>
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-right"></i>
            <span>القائمة</span>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- 1. البيانات الأساسية -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i>
                <span>البيانات الأساسية للمسار</span>
            </div>
            <div class="card-body p-4">
                <div class="info-section-row">
                    <span class="info-lbl">نوع المعاملة</span>
                    <span class="info-val fw-700 text-dark">@Model.TypeLabel</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">رقم الطلب / المرجع</span>
                    <span class="info-val font-monospace">@(Model.ApplicationNumber ?? "—")</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">الجهة المسؤولة</span>
                    <span class="info-val fw-600">@(Model.ResponsibleAuthority ?? "—")</span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">تاريخ التقديم</span>
                    <span class="info-val">
                        @(Model.SubmissionDate.HasValue ? Model.SubmissionDate.Value.ToString("yyyy-MM-dd") : "—")
                    </span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">موعد الإجراء القادم</span>
                    <span class="info-val">
                        @if (Model.NextActionDeadline.HasValue)
                        {
                            var css = Model.HasOverdueDeadline ? "text-danger fw-700" : "text-body";
                            <span class="@css">
                                <i class="bi bi-calendar3 me-1"></i>
                                @Model.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                @if (Model.HasOverdueDeadline)
                                {
                                    <span class="badge bg-danger ms-1">متأخر</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.NextActionDescription))
                {
                    <div class="info-section-row">
                        <span class="info-lbl">الإجراء المطلوب</span>
                        <span class="info-val text-dark fw-600">@Model.NextActionDescription</span>
                    </div>
                }
                <div class="info-section-row">
                    <span class="info-lbl">تاريخ الإنشاء</span>
                    <span class="info-val small text-muted">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
                </div>
                @if (Model.ModifiedAtUtc.HasValue)
                {
                    <div class="info-section-row">
                        <span class="info-lbl">آخر تحديث</span>
                        <span class="info-val small text-muted">@Model.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 2. المتابعة المالية -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-cash-coin text-success"></i>
                <span>المتابعة المالية والتكاليف</span>
            </div>
            <div class="card-body p-4">
                <div class="info-section-row">
                    <span class="info-lbl">إجمالي التكلفة / الرسوم</span>
                    <span class="info-val font-monospace fw-700">
                        @(Model.TotalFee.HasValue ? $"{Model.TotalFee:N2} ريال" : "—")
                    </span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">المبلغ المدفوع</span>
                    <span class="info-val font-monospace text-success fw-700">
                        @(Model.AmountPaid.HasValue ? $"{Model.AmountPaid:N2} ريال" : "—")
                    </span>
                </div>
                <div class="info-section-row">
                    <span class="info-lbl">المتبقي المطلوب</span>
                    <span class="info-val font-monospace">
                        @if (Model.BalanceDue.HasValue)
                        {
                            var balCss = Model.BalanceDue.Value > 0 ? "text-danger fw-700" : "text-success fw-700";
                            <span class="@balCss">@Model.BalanceDue.Value.ToString("N2") ريال</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. المستندات الناقصة إن وجدت -->
    @if (!string.IsNullOrWhiteSpace(Model.MissingDocuments))
    {
        <div class="col-12">
            <div class="card" style="border-right: 4px solid var(--amber); background: var(--amber-light);">
                <div class="card-header d-flex align-items-center gap-2" style="background: transparent; border-bottom: 1px solid rgba(192, 122, 26, 0.2); color: var(--amber);">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span class="fw-700">المستندات والمتطلبات الناقصة المطلوبة</span>
                </div>
                <div class="card-body p-4">
                    <p class="mb-0 text-dark" style="white-space: pre-wrap;">@Model.MissingDocuments</p>
                </div>
            </div>
        </div>
    }

    <!-- 4. ملاحظات داخلية سرية -->
    @if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
    {
        <div class="col-12">
            <div class="card internal-note-card">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <span class="fw-700">ملاحظات داخلية لفريق العمل (سري للغاية)</span>
                </div>
                <div class="card-body p-4">
                    <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.InternalNotes</p>
                </div>
            </div>
        </div>
    }

    <!-- 5. سجل تحديثات وتاريخ الحالة -->
    <div class="col-12">
        <div class="card border-0">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i>
                <span>سجل حركة الحالة وتاريخ المعاملة</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.StatusHistory.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-clock-history"></i>
                        <h6>لا توجد حركات سابقة</h6>
                        <p>لا توجد تغييرات سابقة مسجلة على هذه المعاملة.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>التاريخ (UTC)</th>
                                    <th>من حالة</th>
                                    <th>إلى حالة</th>
                                    <th>ملحوظة التغيير</th>
                                    <th>المستخدم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.StatusHistory)
                                {
                                    <tr>
                                        <td class="text-nowrap small font-monospace">@h.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><partial name="_ProcedureStatusBadge" model="h.FromStatus" /></td>
                                        <td><partial name="_ProcedureStatusBadge" model="h.ToStatus" /></td>
                                        <td class="small">@(h.ChangeNote ?? "—")</td>
                                        <td class="text-muted small">@(h.ChangedByUserId ?? "النظام")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
