@model IReadOnlyList<Ardak.Application.DTOs.DocumentSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "المستندات";
    var filter = ViewBag.Filter as Ardak.Application.DTOs.DocumentSearchFilterDto ?? new Ardak.Application.DTOs.DocumentSearchFilterDto();
    bool hasFilter = !string.IsNullOrEmpty(filter.SearchTerm)
                  || filter.Type.HasValue
                  || filter.ConfidentialityLevel.HasValue
                  || (filter.IsCustomerVisible == true)
                  || (filter.IsArchived == true);
}

<!-- ══ PAGE HEADER ════════════════════════════════════════════ -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3 fade-in">
    <div>
        <h2 class="h3 fw-800 mb-1">
            <i class="bi bi-folder2-open text-warning me-2"></i>مستودع المستندات والصكوك
        </h2>
        <p class="text-muted mb-0 small">أرشيف إلكتروني آمن ومشفّر لجميع وثائق العقارات والمعاملات الرسمية</p>
    </div>
    <a asp-action="Upload" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-cloud-arrow-up"></i>
        <span>رفع مستند جديد</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ FILTER BAR ════════════════════════════════════════════ -->
<div class="filter-bar mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">بحث</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="العنوان، رقم المرجع، أو اسم الملف..." />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small">نوع المستند</label>
            <select name="Type" asp-items="@ViewBag.DocumentTypes" class="form-select">
                <option value="">جميع الأنواع</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">مستوى السرية</label>
            <select name="ConfidentialityLevel" asp-items="@ViewBag.ConfidentialityLevels" class="form-select">
                <option value="">جميع مستويات السرية</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">الرؤية والأرشفة</label>
            <div class="d-flex gap-3 pt-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsCustomerVisible" value="true"
                           @(filter.IsCustomerVisible == true ? "checked" : "") id="chkVisible">
                    <label class="form-check-label small" for="chkVisible">مرئي للعميل</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsArchived" value="true"
                           @(filter.IsArchived == true ? "checked" : "") id="chkArchived">
                    <label class="form-check-label small" for="chkArchived">مؤرشف</label>
                </div>
            </div>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel"></i> تطبيق الفلاتر
            </button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="مسح الفلاتر">
                    <i class="bi bi-arrow-counterclockwise"></i> إعادة تعيين
                </a>
            }
        </div>
    </form>
</div>

<!-- ══ TABLE ═════════════════════════════════════════════════ -->
@if (!Model.Any())
{
    <div class="card border-0 py-5 text-center text-muted">
        <div class="empty-state">
            <i class="bi bi-folder-x"></i>
            <h6>لا توجد مستندات مسجلة</h6>
            <p class="mb-3">لم يتم العثور على أي مستندات تطابق معايير البحث الحالية.</p>
            <a asp-action="Upload" class="btn btn-sm btn-primary rounded-pill px-4 mx-auto">رفع أول مستند</a>
        </div>
    </div>
}
else
{
    <div class="card border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>العنوان والنوع</th>
                        <th>الارتباط</th>
                        <th>السرية</th>
                        <th>وصول العميل</th>
                        <th>تفاصيل الملف</th>
                        <th>تاريخ الرفع (UTC)</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-700">
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="text-decoration-none text-primary">
                                        @doc.Title
                                    </a>
                                </div>
                                <div class="small text-muted d-flex align-items-center gap-1 mt-1">
                                    <span class="badge badge-subtle-primary">@doc.TypeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(doc.ReferenceNumber))
                                    {
                                        <span class="text-muted font-monospace small">مرجع: <code>@doc.ReferenceNumber</code></span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (doc.PropertyId.HasValue)
                                {
                                    <div>
                                        <i class="bi bi-geo-alt text-primary me-1"></i>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@doc.PropertyId" class="text-decoration-none text-dark fw-600 font-monospace small">
                                            @doc.PropertyReferenceNumber
                                        </a>
                                    </div>
                                }
                                @if (doc.CustomerId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-person text-secondary me-1"></i>
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@doc.CustomerId" class="text-decoration-none text-muted">
                                            @doc.CustomerName
                                        </a>
                                    </div>
                                }
                                @if (doc.ProcedureId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-clipboard2-check text-success me-1"></i>
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@doc.ProcedureId" class="text-decoration-none text-muted">
                                            @doc.ProcedureTypeLabel
                                        </a>
                                    </div>
                                }
                                @if (!doc.PropertyId.HasValue && !doc.CustomerId.HasValue && !doc.ProcedureId.HasValue)
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <partial name="_ConfidentialityBadge" model="doc.ConfidentialityLevel" />
                                @if (doc.IsArchived)
                                {
                                    <span class="badge bg-secondary ms-1">مؤرشف</span>
                                }
                            </td>
                            <td>
                                @if (doc.IsCustomerVisible)
                                {
                                    <span class="badge badge-subtle-success">
                                        <i class="bi bi-eye me-1"></i>مرئي للعميل
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-subtle-secondary">
                                        <i class="bi bi-eye-slash me-1"></i>داخلي فقط
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="font-monospace small">@doc.OriginalFileName</div>
                                <div class="small text-muted">@doc.FormattedFileSize &bull; @doc.FileExtension</div>
                            </td>
                            <td>
                                <div class="small text-dark fw-600">@doc.UploadedAtUtc.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted font-monospace">@doc.UploadedAtUtc.ToString("HH:mm") UTC</div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-sm btn-success py-1 px-2" title="تحميل الملف">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-2 px-3 text-muted small d-flex justify-content-between align-items-center">
            <span>إجمالي المستندات: <strong class="text-dark">@Model.Count</strong> مستند</span>
        </div>
    </div>
}
