@model IReadOnlyList<Ardak.Application.DTOs.DocumentSummaryDto>
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "المستندات";
    var filter = ViewBag.Filter as Ardak.Application.DTOs.DocumentSearchFilterDto ?? new Ardak.Application.DTOs.DocumentSearchFilterDto();
}

<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1">
            <i class="bi bi-folder2-open text-warning me-2"></i>مستودع المستندات والصكوك
        </h2>
        <p class="text-muted mb-0 small">أرشيف إلكتروني آمن ومشفّر لجميع وثائق العقارات والمعاملات</p>
    </div>
    <a asp-action="Upload" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-cloud-arrow-up me-1"></i>
        <span>رفع مستند جديد</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- بطاقة البحث والتصفية -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">بحث</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control border-start-0" placeholder="العنوان، رقم المرجع، أو اسم الملف..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">نوع المستند</label>
                <select name="Type" asp-items="@ViewBag.DocumentTypes" class="form-select">
                    <option value="">جميع الأنواع</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">مستوى السرية</label>
                <select name="ConfidentialityLevel" asp-items="@ViewBag.ConfidentialityLevels" class="form-select">
                    <option value="">جميع مستويات السرية</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">الرؤية والأرشفة</label>
                <div class="d-flex gap-3 pt-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsCustomerVisible" value="true"
                               @(filter.IsCustomerVisible == true ? "checked" : "") id="chkVisible">
                        <label class="form-check-label small" for="chkVisible">مرئي للعميل</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsArchived" value="true"
                               @(filter.IsArchived == true ? "checked" : "") id="chkArchived">
                        <label class="form-check-label small" for="chkArchived">مؤرشف</label>
                    </div>
                </div>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-funnel"></i> تطبيق الفلاتر
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i> مسح
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 py-5 text-center text-muted">
        <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
        <p class="mb-2">لا توجد مستندات مسجلة مطابقة لمعايير البحث.</p>
        <a asp-action="Upload" class="btn btn-sm btn-primary mx-auto">رفع أول مستند</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>العنوان والنوع</th>
                        <th>الارتباط</th>
                        <th>السرية</th>
                        <th>وصول العميل</th>
                        <th>تفاصيل الملف</th>
                        <th>تاريخ الرفع (UTC)</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="text-decoration-none text-primary">
                                        @doc.Title
                                    </a>
                                </div>
                                <div class="small text-muted d-flex align-items-center gap-1 mt-1">
                                    <span class="badge badge-subtle-primary">@doc.TypeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(doc.ReferenceNumber))
                                    {
                                        <span class="text-muted font-monospace small">مرجع: <code>@doc.ReferenceNumber</code></span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (doc.PropertyId.HasValue)
                                {
                                    <div>
                                        <i class="bi bi-geo-alt text-primary me-1"></i>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@doc.PropertyId" class="text-decoration-none text-dark fw-semibold">
                                            @doc.PropertyReferenceNumber
                                        </a>
                                    </div>
                                }
                                @if (doc.CustomerId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-person text-secondary me-1"></i>
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@doc.CustomerId" class="text-decoration-none text-muted">
                                            @doc.CustomerName
                                        </a>
                                    </div>
                                }
                                @if (doc.ProcedureId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-clipboard2-check text-success me-1"></i>
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@doc.ProcedureId" class="text-decoration-none text-muted">
                                            @doc.ProcedureTypeLabel
                                        </a>
                                    </div>
                                }
                                @if (!doc.PropertyId.HasValue && !doc.CustomerId.HasValue && !doc.ProcedureId.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <partial name="_ConfidentialityBadge" model="doc.ConfidentialityLevel" />
                                @if (doc.IsArchived)
                                {
                                    <span class="badge bg-secondary ms-1">مؤرشف</span>
                                }
                            </td>
                            <td>
                                @if (doc.IsCustomerVisible)
                                {
                                    <span class="badge badge-subtle-success">
                                        <i class="bi bi-eye me-1"></i>مرئي للعميل
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-subtle-secondary">
                                        <i class="bi bi-eye-slash me-1"></i>داخلي فقط
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="font-monospace small">@doc.OriginalFileName</div>
                                <div class="small text-muted">@doc.FormattedFileSize &bull; @doc.FileExtension</div>
                            </td>
                            <td>
                                <div class="small text-dark fw-semibold">@doc.UploadedAtUtc.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted">@doc.UploadedAtUtc.ToString("HH:mm") UTC</div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-sm btn-success py-1 px-2 me-1" title="تحميل الملف">
                                    <i class="bi bi-download"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1">
                                    <i class="bi bi-eye"></i> عرض
                                </a>
                                <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                    <i class="bi bi-pencil"></i> تعديل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top py-2 px-3 text-muted small d-flex justify-content-between align-items-center">
            <span>إجمالي المستندات: <strong>@Model.Count</strong></span>
        </div>
    </div>
}
