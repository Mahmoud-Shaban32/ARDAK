@model Ardak.Application.DTOs.UpdateDocumentMetadataDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تعديل بيانات المستند – {Model.Title}";
    var doc = ViewBag.Document as Ardak.Application.DTOs.DocumentDetailDto;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">المستندات</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.Title</a></li>
        <li class="breadcrumb-item active text-muted">تعديل</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 fw-bold d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary fs-5"></i>
                    <span>تعديل بيانات وبيانات تعريف المستند</span>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-eye"></i> التفاصيل
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    @if (doc != null)
                    {
                        <div class="p-3 bg-light border rounded-3 mb-4">
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <span class="text-muted small">اسم الملف الأصلي:</span> <strong class="font-monospace">@doc.OriginalFileName</strong>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted small">الحجم:</span> @doc.FormattedFileSize
                                </div>
                                @if (doc.PropertyId.HasValue)
                                {
                                    <div class="col-sm-6">
                                        <span class="text-muted small">العقار:</span> <span class="fw-bold text-primary">@doc.PropertyReferenceNumber</span>
                                    </div>
                                }
                                @if (doc.CustomerId.HasValue)
                                {
                                    <div class="col-sm-6">
                                        <span class="text-muted small">العميل:</span> <span class="fw-bold">@doc.CustomerName</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-bold small text-muted">عنوان المستند <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReferenceNumber" class="form-label fw-bold small text-muted">رقم المرجع</label>
                            <input asp-for="ReferenceNumber" class="form-control font-monospace" dir="ltr" />
                            <span asp-validation-for="ReferenceNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Type" class="form-label fw-bold small text-muted">نوع المستند <span class="text-danger">*</span></label>
                            <select asp-for="Type" asp-items="@ViewBag.DocumentTypes" class="form-select"></select>
                            <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TypeLabel" class="form-label fw-bold small text-muted">مسمى مخصص (في حال اختيار أخرى)</label>
                            <input asp-for="TypeLabel" class="form-control" />
                            <span asp-validation-for="TypeLabel" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold small text-muted">الوصف والملخص</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfidentialityLevel" class="form-label fw-bold small text-muted">مستوى السرية <span class="text-danger">*</span></label>
                            <select asp-for="ConfidentialityLevel" asp-items="@ViewBag.ConfidentialityLevels" class="form-select"></select>
                            <span asp-validation-for="ConfidentialityLevel" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch p-3 border rounded-3 bg-light w-100">
                                <input asp-for="IsCustomerVisible" class="form-check-input" type="checkbox" id="chkCustomerVisible" />
                                <label class="form-check-label fw-bold ms-2" for="chkCustomerVisible">
                                    إتاحة المشاهدة والتحميل للعميل
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="InternalNotes" class="form-label fw-bold small text-muted">ملاحظات سرية للموظفين</label>
                            <textarea asp-for="InternalNotes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="InternalNotes" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4 rounded-pill">إلغاء</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill shadow">
                            <i class="bi bi-check2-circle"></i>
                            <span>حفظ التعديلات</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
