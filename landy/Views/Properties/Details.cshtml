@model PropertyDetailDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"ملف العقار - {Model.ReferenceNumber}";
    var availableCustomers = ViewBag.AvailableCustomers as SelectList;
    var procedures = ViewBag.Procedures as IReadOnlyList<Ardak.Application.DTOs.ProcedureSummaryDto>
                     ?? new List<Ardak.Application.DTOs.ProcedureSummaryDto>();
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">العقارات</a></li>
        <li class="breadcrumb-item active text-muted font-monospace">@Model.ReferenceNumber</li>
    </ol>
</nav>

<!-- Page Header Box -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <span class="badge @(Model.Type == PropertyType.Land ? "badge-subtle-secondary" : "badge-subtle-primary")">
                @(Model.Type == PropertyType.Land ? "أرض" : "فيلا")
            </span>
            <h2 class="h3 fw-bold mb-0">@Model.ReferenceNumber &mdash; @Model.Title</h2>
            @switch (Model.Status)
            {
                case PropertyStatus.Active:
                    <span class="badge badge-subtle-success">نشط</span>
                    break;
                case PropertyStatus.UnderReview:
                    <span class="badge badge-subtle-warning">قيد المراجعة</span>
                    break;
                case PropertyStatus.Reserved:
                    <span class="badge badge-subtle-info">محجوز</span>
                    break;
                case PropertyStatus.Sold:
                    <span class="badge badge-subtle-secondary">مباع</span>
                    break;
                case PropertyStatus.Archived:
                    <span class="badge bg-secondary">مؤرشف</span>
                    break;
            }
        </div>
        <p class="text-muted mb-0 small">
            تاريخ التسجيل: @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm UTC") &bull; آخر تعديل: @(Model.ModifiedAtUtc.HasValue ? Model.ModifiedAtUtc.Value.ToString("yyyy-MM-dd HH:mm UTC") : "لا يوجد")
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill shadow-sm">
            <i class="bi bi-pencil me-1"></i> تعديل العقار
        </a>
        @if (Model.Status == PropertyStatus.Archived)
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success rounded-pill">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> استعادة للنشط
                </button>
            </form>
        }
        else
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger rounded-pill" onclick="return confirm('أرشفة سجل هذا العقار؟');">
                    <i class="bi bi-archive me-1"></i> أرشفة
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-right"></i> القائمة
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- العمود الأيمن: الموقع والمساحة -->
    <div class="col-lg-7">
        <!-- الموقع والوصف -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-geo-alt text-primary fs-5"></i>
                <span>الموقع والوصف التفصيلي</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">المنطقة / المحافظة</div>
                    <div class="col-sm-8 fw-semibold">@Model.Governorate</div>
                </div>
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">المدينة</div>
                    <div class="col-sm-8 fw-semibold">@Model.City</div>
                </div>
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">الحي / المخطط</div>
                    <div class="col-sm-8">@Model.DistrictOrArea</div>
                </div>
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">العنوان التفصيلي</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.AddressDetails) ? "غير محدد" : Model.AddressDetails)</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted small">الوصف</div>
                    <div class="col-sm-8 text-dark">@(string.IsNullOrEmpty(Model.Description) ? "لا يوجد وصف مدخل." : Model.Description)</div>
                </div>
            </div>
        </div>

        <!-- المساحة والبيانات الفنية والصك -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-bounding-box-circles text-success fs-5"></i>
                <span>المساحة، الإحداثيات، وصك الملكية</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">المساحة الإجمالية</div>
                    <div class="col-sm-8 fw-bold text-primary fs-5 font-monospace">
                        @Model.AreaMeasurement.ToString("N2") @Model.AreaUnit
                    </div>
                </div>
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">الإحداثيات الجغرافية (GPS)</div>
                    <div class="col-sm-8">
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <code class="font-monospace bg-light p-1 rounded" dir="ltr">@Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")</code>
                            <a href="https://maps.google.com/?q=@Model.Latitude.Value,@Model.Longitude.Value" target="_blank" class="btn btn-sm btn-outline-primary ms-2 rounded-pill py-0 px-2" style="font-size: 0.8rem;">
                                <i class="bi bi-map me-1"></i> فتح في خرائط Google
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">غير مسجلة</span>
                        }
                    </div>
                </div>
                <div class="row mb-3 pb-2 border-bottom">
                    <div class="col-sm-4 text-muted small">نوع الملكية</div>
                    <div class="col-sm-8">@(string.IsNullOrEmpty(Model.OwnershipType) ? "صك ملكية إلكتروني مطلق" : Model.OwnershipType)</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted small">رقم الصك / الوثيقة</div>
                    <div class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.DeedOrTitleNumber))
                        {
                            <span class="badge bg-light text-dark border font-monospace fs-7">@Model.DeedOrTitleNumber</span>
                        }
                        else
                        {
                            <span class="text-muted">غير متوفر</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- العمود الأيسر: الملاك والملاحظات السرية -->
    <div class="col-lg-5">
        <!-- المالك الأساسي -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-person-check text-primary fs-5"></i>
                <span>المالك الأساسي للعقار</span>
            </div>
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-dark">@Model.PrimaryCustomerName</h6>
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.PrimaryCustomerId" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3">
                        <i class="bi bi-eye"></i> الملف
                    </a>
                </div>
                <p class="text-muted small mb-0 font-monospace" dir="ltr">@Model.PrimaryCustomerPhone</p>
            </div>
        </div>

        <!-- الشركاء والملاك المرتبطين -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-people text-info me-2"></i>الملاك المشتركون والشركاء</span>
                <span class="badge badge-subtle-primary">@Model.AssociatedCustomers.Count إجمالي</span>
            </div>
            <div class="card-body p-4">
                @if (Model.AssociatedCustomers.Any())
                {
                    <ul class="list-group list-group-flush mb-4">
                        @foreach (var assoc in Model.AssociatedCustomers)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-0 border-bottom">
                                <div>
                                    <div class="fw-bold">
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@assoc.CustomerId" class="text-decoration-none text-primary">
                                            @assoc.CustomerName
                                        </a>
                                        <span class="badge badge-subtle-primary ms-1">@assoc.OwnershipRole</span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        النسبة: @(assoc.OwnershipPercentage.HasValue ? $"{assoc.OwnershipPercentage.Value:N1}%" : "غير محدد") &bull; @assoc.CustomerPhone
                                    </div>
                                </div>
                                @if (assoc.CustomerId != Model.PrimaryCustomerId)
                                {
                                    <form asp-action="RemoveCustomerAssociation" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@Model.Id" />
                                        <input type="hidden" name="customerId" value="@assoc.CustomerId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2" onclick="return confirm('إلغاء ربط @assoc.CustomerName بهذا العقار؟');">
                                            <i class="bi bi-x"></i> فك الارتباط
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }

                <!-- نموذج إضافة مالك مشارك -->
                @if (availableCustomers != null && availableCustomers.Any())
                {
                    <div class="p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold mb-2 small">ربط عميل إضافي (شريك / مستثمر)</h6>
                        <form asp-action="AssociateCustomer" method="post" class="row g-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="propertyId" value="@Model.Id" />
                            <div class="col-12">
                                <select name="customerId" class="form-select form-select-sm" asp-items="availableCustomers" required>
                                    <option value="">-- اختر العميل --</option>
                                </select>
                            </div>
                            <div class="col-md-7">
                                <input type="text" name="role" class="form-control form-control-sm" placeholder="الصفة (شريك، مساهم)" value="شريك" />
                            </div>
                            <div class="col-md-5">
                                <input type="number" step="0.01" name="ownershipPercentage" class="form-control form-control-sm" placeholder="النسبة %" />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill">
                                    <i class="bi bi-plus-circle me-1"></i> إضافة ارتباط العميل
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- ملاحظات داخلية سرية -->
        <div class="card shadow-sm border-0 border-start border-4 border-danger">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-danger d-flex align-items-center gap-1">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>ملاحظات داخلية لفريق العمل</span>
                    </h6>
                    <span class="badge badge-subtle-danger">سري للغاية</span>
                </div>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
                {
                    <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.InternalNotes</p>
                }
                else
                {
                    <p class="text-muted mb-0 small">لا توجد ملاحظات داخلية مسجلة لهذا العقار.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- المعاملات المرتبطة بهذا العقار -->
<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0"><i class="bi bi-clipboard2-check text-primary me-2"></i>المعاملات والإجراءات الرسمية للعقار</h5>
        <a asp-controller="Procedures" asp-action="Create" asp-route-propertyId="@Model.Id" class="btn btn-sm btn-primary rounded-pill shadow-xs">
            <i class="bi bi-plus-circle me-1"></i> معاملة جديدة
        </a>
    </div>
    <div class="card-body p-0">
        @if (!procedures.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-clipboard2-x fs-1 d-block mb-2 text-secondary"></i>
                لا توجد معاملات مسجلة لهذا العقار حتى الآن.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>النوع</th>
                            <th>رقم الطلب</th>
                            <th>الجهة المسؤولة</th>
                            <th>الحالة</th>
                            <th>الموعد القادم</th>
                            <th class="text-end">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in procedures)
                        {
                            <tr>
                                <td><span class="badge badge-subtle-primary">@p.TypeLabel</span></td>
                                <td class="font-monospace">@(p.ApplicationNumber ?? "—")</td>
                                <td>@(p.ResponsibleAuthority ?? "—")</td>
                                <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                <td>
                                    @if (p.NextActionDeadline.HasValue)
                                    {
                                        var css = p.HasOverdueDeadline ? "text-danger fw-bold" : "text-body";
                                        <span class="@css">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @p.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                            @if (p.HasOverdueDeadline)
                                            {
                                                <span class="badge bg-danger ms-1">متأخر</span>
                                            }
                                        </span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1">
                                        <i class="bi bi-eye"></i> عرض
                                    </a>
                                    <a asp-controller="Procedures" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                        <i class="bi bi-pencil"></i> تعديل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
