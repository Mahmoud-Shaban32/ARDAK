@model UpdatePropertyDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = $"تعديل العقار - {Model.ReferenceNumber}";
    var customers = ViewBag.Customers as SelectList;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">العقارات</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none font-monospace">@Model.ReferenceNumber</a></li>
        <li class="breadcrumb-item active text-muted">تعديل</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 fw-bold d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-success fs-5"></i>
                    <span>تعديل ملف العقار: @Model.ReferenceNumber</span>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-eye"></i> التفاصيل
                </a>
            </div>
            <div class="card-body p-4">
                <p class="text-muted small mb-4">
                    تعديل مواصفات العقار وبيانات الموقع وصك الملكية وحالته التشغيلية.
                </p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                {
                    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>
                            @Html.ValidationSummary(true, "", new { @class = "mb-0 list-unstyled" })
                        </div>
                    </div>
                }

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <!-- 1. التعريف والحالة -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-1-circle-fill"></i>
                                <span>التعريف والحالة والمالك</span>
                            </h6>
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label asp-for="ReferenceNumber" class="form-label fw-bold small text-muted">الرقم المرجعي <span class="text-danger">*</span></label>
                                    <input asp-for="ReferenceNumber" class="form-control font-monospace" />
                                    <span asp-validation-for="ReferenceNumber" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Type" class="form-label fw-bold small text-muted">نوع العقار <span class="text-danger">*</span></label>
                                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<PropertyType>()"></select>
                                    <span asp-validation-for="Type" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Status" class="form-label fw-bold small text-muted">الحالة التشغيلية <span class="text-danger">*</span></label>
                                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PropertyStatus>()"></select>
                                    <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="PrimaryCustomerId" class="form-label fw-bold small text-muted">المالك الأساسي <span class="text-danger">*</span></label>
                                    <select asp-for="PrimaryCustomerId" class="form-select" asp-items="customers"></select>
                                    <span asp-validation-for="PrimaryCustomerId" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-bold small text-muted">عنوان / اسم العقار <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-0">
                                <label asp-for="Description" class="form-label fw-bold small text-muted">الوصف التفصيلي</label>
                                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. تفاصيل الموقع -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-2-circle-fill"></i>
                                <span>تفاصيل الموقع</span>
                            </h6>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Governorate" class="form-label fw-bold small text-muted">المنطقة / المحافظة</label>
                                    <input asp-for="Governorate" class="form-control" />
                                    <span asp-validation-for="Governorate" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="City" class="form-label fw-bold small text-muted">المدينة <span class="text-danger">*</span></label>
                                    <input asp-for="City" class="form-control" />
                                    <span asp-validation-for="City" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="DistrictOrArea" class="form-label fw-bold small text-muted">الحي / المنطقة <span class="text-danger">*</span></label>
                                    <input asp-for="DistrictOrArea" class="form-control" />
                                    <span asp-validation-for="DistrictOrArea" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="AddressDetails" class="form-label fw-bold small text-muted">تفاصيل الشارع والعنوان</label>
                                <input asp-for="AddressDetails" class="form-control" />
                                <span asp-validation-for="AddressDetails" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. المساحة والصك والإحداثيات -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-3-circle-fill"></i>
                                <span>المساحة، الصك، والإحداثيات</span>
                            </h6>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="AreaMeasurement" class="form-label fw-bold small text-muted">المساحة <span class="text-danger">*</span></label>
                                    <input asp-for="AreaMeasurement" class="form-control font-monospace" type="number" step="0.01" />
                                    <span asp-validation-for="AreaMeasurement" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label asp-for="AreaUnit" class="form-label fw-bold small text-muted">الوحدة</label>
                                    <input asp-for="AreaUnit" class="form-control" />
                                    <span asp-validation-for="AreaUnit" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Latitude" class="form-label fw-bold small text-muted">خط العرض</label>
                                    <input asp-for="Latitude" class="form-control font-monospace" type="number" step="any" dir="ltr" />
                                    <span asp-validation-for="Latitude" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label asp-for="Longitude" class="form-label fw-bold small text-muted">خط الطول</label>
                                    <input asp-for="Longitude" class="form-control font-monospace" type="number" step="any" dir="ltr" />
                                    <span asp-validation-for="Longitude" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-0">
                                    <label asp-for="OwnershipType" class="form-label fw-bold small text-muted">نوع الملكية</label>
                                    <input asp-for="OwnershipType" class="form-control" />
                                    <span asp-validation-for="OwnershipType" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-6 mb-0">
                                    <label asp-for="DeedOrTitleNumber" class="form-label fw-bold small text-muted">رقم الصك</label>
                                    <input asp-for="DeedOrTitleNumber" class="form-control font-monospace" dir="ltr" />
                                    <span asp-validation-for="DeedOrTitleNumber" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. ملاحظات داخلية سرية -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-2">
                                <h6 class="fw-bold text-danger mb-0 d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <span>ملاحظات داخلية لفريق العمل</span>
                                </h6>
                                <span class="badge badge-subtle-danger ms-2">سري للغاية &bull; خاص بالموظفين</span>
                            </div>
                            <textarea asp-for="InternalNotes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="InternalNotes" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4 rounded-pill">إلغاء</a>
                        <button type="submit" class="btn btn-success px-4 rounded-pill shadow">
                            <i class="bi bi-check2-circle"></i>
                            <span>حفظ التعديلات</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
