@model Ardak.Application.DTOs.AdminDashboardDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "لوحة التحكم التنفيذية";
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<!-- ══ EXECUTIVE LUXURY HERO BANNER ════════════════════════════ -->
<div class="executive-hero-banner fade-in">
    <div class="executive-hero-content">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    @if (isSuperAdmin)
                    {
                        <span class="badge py-1 px-3" style="background: rgba(197, 155, 39, 0.25); color: #fde68a; border: 1px solid rgba(253, 230, 138, 0.4); font-size: 0.78rem;">
                            <i class="bi bi-shield-shaded me-1"></i>صلاحية المشرف العام
                        </span>
                    }
                    else
                    {
                        <span class="badge py-1 px-3" style="background: rgba(16, 147, 115, 0.25); color: #a7f3d0; border: 1px solid rgba(167, 243, 208, 0.4); font-size: 0.78rem;">
                            <i class="bi bi-person-check-fill me-1"></i>مشرف نظام
                        </span>
                    }
                    <span class="badge py-1 px-3" style="background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.85); font-size: 0.78rem;">
                        <i class="bi bi-calendar3 me-1"></i>@DateTime.UtcNow.ToString("dd MMMM yyyy")
                    </span>
                </div>
                <h1 class="executive-title">لوحة الإدارة والتحكم التنفيذية</h1>
                <p class="executive-sub">
                    نظام إدارة الأصول العقارية المتقدم &bull; تدقيق صكوك الملكية الإلكترونية ومتابعة مسار المعاملات الحكومية الرسمية
                </p>
            </div>

            <!-- User Context -->
            <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.14);">
                <div class="user-avatar-initials" style="width: 36px; height: 36px; font-size: 0.85rem;">
                    @(isSuperAdmin ? "SA" : "AD")
                </div>
                <div class="text-end pe-2">
                    <div class="small fw-bold text-white font-monospace">@ViewBag.UserEmail</div>
                    <div class="small text-muted" style="color: rgba(255, 255, 255, 0.6) !important; font-size: 0.72rem;">متصل بنظام مشفّر</div>
                </div>
            </div>
        </div>

        <!-- Executive Primary Action Bar -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.12) !important;">
            <a asp-controller="Properties" asp-action="Create" class="btn-executive-primary">
                <i class="bi bi-building-add fs-5"></i>
                <span>تسجيل عقار جديد</span>
            </a>
            <a asp-controller="Customers" asp-action="Create" class="btn-executive-outline">
                <i class="bi bi-person-plus text-success"></i>
                <span>عميل جديد</span>
            </a>
            <a asp-controller="Procedures" asp-action="Create" class="btn-executive-outline">
                <i class="bi bi-clipboard-plus text-info"></i>
                <span>معاملة رسمية</span>
            </a>
            <a asp-controller="Documents" asp-action="Upload" class="btn-executive-outline">
                <i class="bi bi-cloud-arrow-up text-warning"></i>
                <span>رفع صك / وثيقة</span>
            </a>
            @if (isSuperAdmin)
            {
                <a asp-controller="AdminManagement" asp-action="Index" class="btn-executive-outline me-auto" style="border-color: rgba(239, 68, 68, 0.4); color: #fca5a5 !important;">
                    <i class="bi bi-shield-lock text-danger"></i>
                    <span>إدارة المشرفين</span>
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ EXECUTIVE KPI METRIC CARDS ═════════════════════════════ -->
<div class="row g-3 mb-4">
    <!-- Properties Card -->
    <div class="col-xl-3 col-md-6">
        <div class="luxury-metric-card card-emerald">
            <div class="metric-header">
                <div>
                    <span class="badge badge-subtle-success mb-2 d-inline-block">المحفظة العقارية</span>
                    <div class="metric-title">إجمالي العقارات المسجلة</div>
                </div>
                <div class="metric-icon-wrap icon-wrap-emerald">
                    <i class="bi bi-houses"></i>
                </div>
            </div>
            <div class="metric-main-value">@Model.TotalProperties</div>
            <div class="metric-footer">
                <span class="text-muted">
                    <strong class="text-success font-monospace">@Model.ActiveProperties</strong> عقار نشط
                </span>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill" style="font-size: 0.8rem;">
                    <span>إدارة المحفظة</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Customers Card -->
    <div class="col-xl-3 col-md-6">
        <div class="luxury-metric-card card-navy">
            <div class="metric-header">
                <div>
                    <span class="badge badge-subtle-primary mb-2 d-inline-block">قاعدة المستثمرين</span>
                    <div class="metric-title">إجمالي العملاء والملاك</div>
                </div>
                <div class="metric-icon-wrap icon-wrap-navy">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="metric-main-value">@Model.TotalCustomers</div>
            <div class="metric-footer">
                <span class="text-muted">
                    <strong class="text-primary font-monospace">@Model.ActiveCustomers</strong> ملف معتمد
                </span>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill" style="font-size: 0.8rem;">
                    <span>سجل العملاء</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Procedures Card -->
    <div class="col-xl-3 col-md-6">
        <div class="luxury-metric-card card-gold">
            <div class="metric-header">
                <div>
                    <span class="badge badge-subtle-gold mb-2 d-inline-block">المسار القانوني</span>
                    <div class="metric-title">المعاملات والإجراءات الرسمية</div>
                </div>
                <div class="metric-icon-wrap icon-wrap-gold">
                    <i class="bi bi-file-earmark-check"></i>
                </div>
            </div>
            <div class="metric-main-value">@Model.TotalProcedures</div>
            <div class="metric-footer">
                <span class="text-muted">
                    <strong class="text-warning font-monospace">@Model.PendingProceduresCount</strong> قيد المتابعة
                </span>
                <a asp-controller="Procedures" asp-action="Index" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill" style="font-size: 0.8rem;">
                    <span>المعاملات</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Documents Card -->
    <div class="col-xl-3 col-md-6">
        <div class="luxury-metric-card card-cyan">
            <div class="metric-header">
                <div>
                    <span class="badge badge-subtle-info mb-2 d-inline-block">الأرشيف الرقمي</span>
                    <div class="metric-title">المستندات والصكوك الموثقة</div>
                </div>
                <div class="metric-icon-wrap icon-wrap-cyan">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
            <div class="metric-main-value">@Model.TotalDocuments</div>
            <div class="metric-footer">
                <span class="text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i>مستودع صكوك مشفّر
                </span>
                <a asp-controller="Documents" asp-action="Index" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill" style="font-size: 0.8rem;">
                    <span>الأرشيف</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ══ OPERATIONAL HEALTH & ACTIONABLE STATUS ══════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ops-health-card">
            <div class="ops-icon ops-warning">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="text-muted small fw-bold">معاملات قيد الإجراء</span>
                    <span class="ops-val text-warning font-monospace">@Model.PendingProceduresCount</span>
                </div>
                <div class="small text-muted mt-1">تتطلب متابعة مع الجهات المختصة</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="ops-health-card">
            <div class="ops-icon ops-danger">
                <i class="bi bi-alarm-fill"></i>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="text-muted small fw-bold">مواعيد مستحقة أو متأخرة</span>
                    <span class="ops-val text-danger font-monospace">@Model.OverdueDeadlinesCount</span>
                </div>
                <div class="small text-muted mt-1">
                    @(Model.OverdueDeadlinesCount > 0 ? "تتطلب إجراءً عاجلاً فورياً" : "لا توجد مواعيد متأخرة حالياً")
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="ops-health-card">
            <div class="ops-icon ops-info">
                <i class="bi bi-file-earmark-x"></i>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="text-muted small fw-bold">متطلبات وصكوك ناقصة</span>
                    <span class="ops-val text-info font-monospace">@Model.ProceduresWithMissingDocsCount</span>
                </div>
                <div class="small text-muted mt-1">
                    @(Model.ProceduresWithMissingDocsCount > 0 ? "بانتظار إرفاق وثائق ثبوتية" : "جميع المتطلبات مستوفاة بالكامل")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ REAL ESTATE DISCOVERY & ONBOARDING SHOWCASE ══════════════ -->
<div class="card mb-4 border-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-houses text-primary fs-5"></i>
            <span class="fw-800">محفظة الأصول العقارية والمعاينة السريعة</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Properties" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-grid me-1"></i>
                <span>استعراض كافة العقارات</span>
            </a>
            <a asp-controller="Properties" asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i>
                <span>إضافة عقار</span>
            </a>
        </div>
    </div>
    <div class="card-body p-4">
        @if (Model.TotalProperties == 0)
        {
            <!-- Luxury Guided Onboarding Cards when portfolio is empty -->
            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    <div class="p-4 rounded-4 text-white" style="background: linear-gradient(135deg, #0a1520 0%, #0f2236 100%); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <span class="badge py-1 px-3 mb-3" style="background: rgba(16, 147, 115, 0.3); color: #6ee7b7; border: 1px solid rgba(110, 231, 183, 0.4);">
                            <i class="bi bi-sparkles me-1"></i>جاهز لتسجيل أول أصل عقاري
                        </span>
                        <h4 class="fw-900 mb-2 text-white">ابدأ ببناء محفظتك العقارية الرقمية</h4>
                        <p class="small text-muted mb-4" style="color: rgba(255, 255, 255, 0.7) !important; line-height: 1.7;">
                            يتيح لك نظام أرضك تسجيل الأراضي والفلل، ربط صكوك الملكية الإلكترونية، توثيق إحداثيات GPS، وتعيين الملاك الأساسيين والشركاء بنسب دقيقة وموثقة.
                        </p>
                        <a asp-controller="Properties" asp-action="Create" class="btn btn-success w-100 rounded-pill py-2 shadow-sm">
                            <i class="bi bi-plus-circle me-1"></i>
                            <span>تسجيل عقار جديد الآن</span>
                        </a>
                    </div>
                </div>

                <!-- Showcase Preview Cards -->
                <div class="col-lg-7">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="realestate-card h-100">
                                <div class="realestate-img-box" style="background: linear-gradient(135deg, #182d44 0%, #0f2236 100%);">
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-white p-3 text-center">
                                        <i class="bi bi-house-door fs-1 text-emerald-400 mb-2" style="color: var(--emerald-400);"></i>
                                        <span class="fw-bold small">فلل سكنية وقصور فاخرة</span>
                                        <span class="small" style="color: rgba(255, 255, 255, 0.5); font-size: 0.75rem;">توثيق المساحات وتراخيص البناء</span>
                                    </div>
                                    <div class="realestate-badge-top">
                                        <span class="badge badge-subtle-primary">فيلا</span>
                                    </div>
                                    <div class="realestate-badge-left">
                                        <span class="badge badge-subtle-success">نموذج معتمد</span>
                                    </div>
                                </div>
                                <div class="realestate-body p-3">
                                    <div class="realestate-title small">تسجيل الفلل والوحدات العقارية</div>
                                    <div class="text-muted small mb-2">إدارة المخططات، عدادات الخدمات، وصكوك الفرز المعتمدة</div>
                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <span class="small text-muted">صك إلكتروني</span>
                                        <a asp-controller="Properties" asp-action="Create" class="small fw-bold text-primary">تسجيل فيلا &larr;</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="realestate-card h-100">
                                <div class="realestate-img-box" style="background: linear-gradient(135deg, #132b45 0%, #0a1520 100%);">
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-white p-3 text-center">
                                        <i class="bi bi-geo fs-1 mb-2" style="color: var(--gold-400);"></i>
                                        <span class="fw-bold small">أراضي خام ومخططات تجارية</span>
                                        <span class="small" style="color: rgba(255, 255, 255, 0.5); font-size: 0.75rem;">خرائط كاداستر وإحداثيات GPS</span>
                                    </div>
                                    <div class="realestate-badge-top">
                                        <span class="badge badge-subtle-gold">أرض</span>
                                    </div>
                                    <div class="realestate-badge-left">
                                        <span class="badge badge-subtle-success">نموذج استثماري</span>
                                    </div>
                                </div>
                                <div class="realestate-body p-3">
                                    <div class="realestate-title small">تسجيل الأراضي والمخططات</div>
                                    <div class="text-muted small mb-2">ربط أرقام القطع، أطوال الشوارع، وإفادات أمانات المناطق</div>
                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                        <span class="small text-muted">متر مربع</span>
                                        <a asp-controller="Properties" asp-action="Create" class="small fw-bold text-primary">تسجيل أرض &larr;</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light">
                <span class="fw-bold text-dark">يوجد حالياً @Model.TotalProperties عقار مسجّل في النظام.</span>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-4">
                    <span>استعراض سجل العقارات الكامل</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        }
    </div>
</div>

<!-- ══ DISTRIBUTION AND STATUS GRIDS ══════════════════════════ -->
<div class="row g-4 mb-4">
    <!-- Property Types Breakdown -->
    <div class="col-lg-6">
        <div class="card h-100 border-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2 fw-800">
                    <i class="bi bi-pie-chart text-primary"></i>
                    <span>توزيع الأصول حسب النوع والتشغيل</span>
                </span>
                <span class="badge badge-subtle-secondary">إحصائيات مباشرة</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="text-muted small fw-bold mb-3 border-bottom pb-2">أنواع الأصول العقارية</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var kv in Model.PropertiesByType)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom">
                                    <span class="fw-700">
                                        <i class="@(kv.Key == "Land" ? "bi bi-geo" : "bi bi-house-door") text-muted me-1"></i>
                                        @(kv.Key == "Land" ? "أرض" : (kv.Key == "Villa" ? "فيلا" : kv.Key))
                                    </span>
                                    <span class="badge badge-subtle-primary font-monospace">@kv.Value</span>
                                </li>
                            }
                            @if (!Model.PropertiesByType.Any())
                            {
                                <li class="list-group-item text-muted small px-0">لا توجد عقارات مسجّلة بعد.</li>
                            }
                        </ul>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small fw-bold mb-3 border-bottom pb-2">الحالة التشغيلية</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var kv in Model.PropertiesByStatus)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom">
                                    <span class="fw-700">
                                        @switch (kv.Key)
                                        {
                                            case "Active": <span class="badge badge-subtle-success">نشط</span>; break;
                                            case "UnderReview": <span class="badge badge-subtle-warning">قيد المراجعة</span>; break;
                                            case "Reserved": <span class="badge badge-subtle-info">محجوز</span>; break;
                                            case "Sold": <span class="badge badge-subtle-secondary">مباع</span>; break;
                                            case "Archived": <span class="badge bg-secondary">مؤرشف</span>; break;
                                            default: <span>@kv.Key</span>; break;
                                        }
                                    </span>
                                    <span class="fw-800 font-monospace text-dark">@kv.Value</span>
                                </li>
                            }
                            @if (!Model.PropertiesByStatus.Any())
                            {
                                <li class="list-group-item text-muted small px-0">لا توجد حالات مسجّلة.</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Procedures by Status -->
    <div class="col-lg-6">
        <div class="card h-100 border-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2 fw-800">
                    <i class="bi bi-bar-chart-steps text-info"></i>
                    <span>حالات المعاملات في المسار القانوني</span>
                </span>
                <span class="badge badge-subtle-info">المسارات النشطة</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-2">
                    @foreach (var kv in Model.ProceduresByStatus)
                    {
                        <div class="col-sm-6">
                            <div class="p-2 border rounded-3 d-flex justify-content-between align-items-center bg-light">
                                <span class="fw-700 small">
                                    @switch (kv.Key)
                                    {
                                        case "Submitted": <span>مُقدَّم</span>; break;
                                        case "InProgress": <span>قيد الإجراء</span>; break;
                                        case "PendingRequirements": <span>بانتظار متطلبات</span>; break;
                                        case "UnderReview": <span>قيد المراجعة</span>; break;
                                        case "Approved": <span>معتمد</span>; break;
                                        case "Rejected": <span>مرفوض</span>; break;
                                        case "Completed": <span>منجز</span>; break;
                                        case "Cancelled": <span>ملغى</span>; break;
                                        default: <span>@kv.Key</span>; break;
                                    }
                                </span>
                                <span class="badge bg-primary rounded-pill font-monospace">@kv.Value</span>
                            </div>
                        </div>
                    }
                    @if (!Model.ProceduresByStatus.Any())
                    {
                        <div class="col-12 text-muted small py-4 text-center">لا توجد معاملات مسجّلة في النظام حالياً.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ INTERACTIVE WORKFLOW ACTION CENTER ══════════════════════ -->
<div class="card mb-4 border-0">
    <div class="card-header bg-white py-2 border-bottom">
        <ul class="nav nav-tabs card-header-tabs" id="dashboardTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-800" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                    <i class="bi bi-hourglass-split text-warning me-1"></i>
                    <span>معاملات قيد الانتظار (@Model.PendingProcedures.Count)</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-800" id="missing-tab" data-bs-toggle="tab" data-bs-target="#missing" type="button" role="tab">
                    <i class="bi bi-file-earmark-x text-info me-1"></i>
                    <span>مستندات ناقصة (@Model.ProceduresWithMissingDocuments.Count)</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-800" id="deadlines-tab" data-bs-toggle="tab" data-bs-target="#deadlines" type="button" role="tab">
                    <i class="bi bi-alarm text-danger me-1"></i>
                    <span>مواعيد قادمة (@Model.UpcomingDeadlines.Count)</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="dashboardTabsContent">
            <!-- Tab 1: Pending Procedures -->
            <div class="tab-pane fade show active" id="pending" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>نوع المعاملة</th>
                                <th>العقار المرتبط</th>
                                <th>الجهة المسؤولة</th>
                                <th>الحالة</th>
                                <th>الموعد القادم</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingProcedures.Any())
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="luxury-empty-state">
                                            <div class="luxury-empty-icon">
                                                <i class="bi bi-check2-circle text-success"></i>
                                            </div>
                                            <h5>جميع المعاملات منجزة وفي مسارها الطبيعي</h5>
                                            <p>لا توجد معاملات معلقة بحاجة إلى إجراء حالياً في هذا القسم.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.PendingProcedures)
                            {
                                <tr>
                                    <td>
                                        <span class="badge badge-subtle-primary">@p.TypeLabel</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="fw-700 text-decoration-none text-primary font-monospace small">
                                            @p.PropertyReferenceNumber
                                        </a>
                                        <div class="small text-muted">@p.PropertyTitle</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border small">
                                            @(p.ResponsibleAuthority ?? "—")
                                        </span>
                                    </td>
                                    <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                    <td>
                                        @if (p.NextActionDeadline.HasValue)
                                        {
                                            var css = p.HasOverdueDeadline ? "text-danger fw-700" : "text-body";
                                            <span class="@css small">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @p.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                                @if (p.HasOverdueDeadline)
                                                {
                                                    <span class="badge bg-danger ms-1">متأخر</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                        <a asp-controller="Procedures" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 2: Missing Documents -->
            <div class="tab-pane fade" id="missing" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>نوع المعاملة</th>
                                <th>العقار</th>
                                <th>المتطلبات المعلقة</th>
                                <th>الحالة</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ProceduresWithMissingDocuments.Any())
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="luxury-empty-state">
                                            <div class="luxury-empty-icon">
                                                <i class="bi bi-file-earmark-check text-success"></i>
                                            </div>
                                            <h5>كافة الوثائق والصكوك مكتملة</h5>
                                            <p>لا توجد مستندات ناقصة مطلوبة في أي من المعاملات النشطة.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.ProceduresWithMissingDocuments)
                            {
                                <tr>
                                    <td><span class="badge badge-subtle-primary">@p.TypeLabel</span></td>
                                    <td>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="fw-700 text-decoration-none font-monospace small">
                                            @p.PropertyReferenceNumber
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-warning-emphasis d-inline-flex align-items-center gap-1 small">
                                            <i class="bi bi-exclamation-circle text-warning"></i>
                                            @p.NextActionDescription
                                        </span>
                                    </td>
                                    <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                    <td class="text-end">
                                        <a asp-controller="Documents" asp-action="Upload" asp-route-propertyId="@p.PropertyId" asp-route-procedureId="@p.Id" class="btn btn-sm btn-success py-1 px-2 me-1">
                                            <i class="bi bi-cloud-arrow-up"></i> رفع المستند
                                        </a>
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 3: Upcoming Deadlines -->
            <div class="tab-pane fade" id="deadlines" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>الموعد النهائي</th>
                                <th>نوع المعاملة</th>
                                <th>العقار</th>
                                <th>المهمة / الإجراء المطلوب</th>
                                <th>الحالة</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UpcomingDeadlines.Any())
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="luxury-empty-state">
                                            <div class="luxury-empty-icon">
                                                <i class="bi bi-calendar-check text-success"></i>
                                            </div>
                                            <h5>لا توجد مواعيد حرجة قادمة</h5>
                                            <p>جميع المواعيد والالتزامات تسير وفق الجدول الزمني المعتمد.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.UpcomingDeadlines)
                            {
                                <tr>
                                    <td>
                                        @if (p.NextActionDeadline.HasValue)
                                        {
                                            var css = p.HasOverdueDeadline ? "text-danger fw-700" : "text-body fw-700";
                                            <span class="@css small">
                                                <i class="bi bi-alarm me-1"></i>
                                                @p.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                                @if (p.HasOverdueDeadline)
                                                {
                                                    <span class="badge bg-danger ms-1">متأخر</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td><span class="badge badge-subtle-primary">@p.TypeLabel</span></td>
                                    <td>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="fw-700 text-decoration-none font-monospace small">
                                            @p.PropertyReferenceNumber
                                        </a>
                                    </td>
                                    <td class="small">@(p.NextActionDescription ?? "مراجعة معلقة")</td>
                                    <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                    <td class="text-end">
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                        <a asp-controller="Procedures" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══ LIVE ADMINISTRATIVE ACTIVITY STREAM ═════════════════════ -->
<div class="card mb-4 border-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="d-flex align-items-center gap-2 fw-800">
            <i class="bi bi-clock-history text-primary"></i>
            <span>سجل العمليات والنشاط الإداري المباشر</span>
        </span>
        <span class="badge badge-subtle-success">
            <i class="bi bi-broadcast text-success me-1"></i>سجل موثّق
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentActivities.Any())
        {
            <div class="luxury-empty-state py-4">
                <i class="bi bi-activity fs-1 text-muted mb-2 d-block"></i>
                <h6>لا يوجد نشاط حديث مسجّل حتى الآن</h6>
                <p class="small text-muted mb-0">ستظهر هنا تفاصيل العمليات وإدخال العقارات وتعديل الحالات فور حدوثها.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var act in Model.RecentActivities)
                {
                    <div class="list-group-item p-3 border-0 border-bottom">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div class="d-flex align-items-start gap-3">
                                <div class="metric-icon-wrap icon-wrap-navy mt-1" style="width: 38px; height: 38px; font-size: 1.1rem; border-radius: 50%;">
                                    <i class="bi bi-activity"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge @act.BadgeCss">@act.ActivityType</span>
                                        <strong class="text-dark">@act.Title</strong>
                                    </div>
                                    <div class="text-muted small mt-1">@act.Description</div>
                                </div>
                            </div>
                            <div class="text-end ms-auto">
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-clock me-1"></i>@act.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                </div>
                                @if (!string.IsNullOrWhiteSpace(act.LinkController) && act.LinkId.HasValue)
                                {
                                    <a asp-controller="@act.LinkController" asp-action="@act.LinkAction" asp-route-id="@act.LinkId.Value" class="btn btn-sm btn-link p-0 text-decoration-none text-primary fw-700">
                                        <span>عرض السجل</span>
                                        <i class="bi bi-arrow-left"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
