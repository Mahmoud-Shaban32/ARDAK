@model Ardak.Application.DTOs.AdminDashboardDto
@using Ardak.Model.Enums
@{
    ViewData["Title"] = "لوحة التحكم الإدارية";
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<!-- Page Header with Greeting & Quick Actions -->
<div class="page-header-box d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 fw-bold mb-0">لوحة التحكم الرئيسية</h1>
            @if (isSuperAdmin)
            {
                <span class="badge bg-danger shadow-sm">مشرف عام</span>
            }
            else
            {
                <span class="badge bg-primary shadow-sm">مشرف</span>
            }
        </div>
        <p class="text-muted mb-0 small">
            <i class="bi bi-clock me-1 text-primary"></i>
            أهلاً بك &bull; مسجّل الدخول بـ: <strong class="text-dark">@ViewBag.UserEmail</strong>
        </p>
    </div>

    <!-- Top Quick Action Pill Buttons -->
    <div class="d-flex gap-2 flex-wrap">
        @if (isSuperAdmin)
        {
            <a asp-controller="AdminManagement" asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill shadow-xs">
                <i class="bi bi-shield-lock"></i> لوحة المشرفين
            </a>
        }
        <a asp-controller="Customers" asp-action="Create" class="action-pill-btn">
            <i class="bi bi-person-plus text-primary"></i>
            <span>عميل جديد</span>
        </a>
        <a asp-controller="Properties" asp-action="Create" class="action-pill-btn">
            <i class="bi bi-building-add text-success"></i>
            <span>عقار جديد</span>
        </a>
        <a asp-controller="Procedures" asp-action="Create" class="action-pill-btn">
            <i class="bi bi-clipboard-plus text-info"></i>
            <span>معاملة جديدة</span>
        </a>
        <a asp-controller="Documents" asp-action="Upload" class="action-pill-btn">
            <i class="bi bi-cloud-arrow-up text-secondary"></i>
            <span>رفع مستند</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Primary Overview Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Customers Card -->
    <div class="col-xl-3 col-md-6">
        <div class="metric-card card-primary h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">إجمالي العملاء</div>
                    <div class="metric-value">@Model.TotalCustomers</div>
                </div>
                <div class="metric-icon-box icon-box-primary">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="small text-muted">
                    <strong class="text-success">@Model.ActiveCustomers</strong> ملف نشط
                </span>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-sm btn-light py-1 px-2 text-primary" style="font-size: 0.8rem;">
                    <span>إدارة</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Properties Card -->
    <div class="col-xl-3 col-md-6">
        <div class="metric-card card-emerald h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">إجمالي العقارات</div>
                    <div class="metric-value">@Model.TotalProperties</div>
                </div>
                <div class="metric-icon-box icon-box-emerald">
                    <i class="bi bi-houses"></i>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="small text-muted">
                    <strong class="text-success">@Model.ActiveProperties</strong> عقار نشط
                </span>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-sm btn-light py-1 px-2 text-success" style="font-size: 0.8rem;">
                    <span>إدارة</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Procedures Card -->
    <div class="col-xl-3 col-md-6">
        <div class="metric-card card-cyan h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">إجمالي المعاملات</div>
                    <div class="metric-value">@Model.TotalProcedures</div>
                </div>
                <div class="metric-icon-box icon-box-cyan">
                    <i class="bi bi-file-earmark-check"></i>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="small text-muted">
                    <strong class="text-warning">@Model.PendingProceduresCount</strong> قيد المتابعة
                </span>
                <a asp-controller="Procedures" asp-action="Index" class="btn btn-sm btn-light py-1 px-2 text-info" style="font-size: 0.8rem;">
                    <span>إدارة</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Documents Card -->
    <div class="col-xl-3 col-md-6">
        <div class="metric-card card-amber h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="metric-label">المستندات المحفوظة</div>
                    <div class="metric-value">@Model.TotalDocuments</div>
                </div>
                <div class="metric-icon-box icon-box-amber">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <span class="small text-muted">
                    <i class="bi bi-shield-check text-success me-1"></i>مستودع مشفّر
                </span>
                <a asp-controller="Documents" asp-action="Index" class="btn btn-sm btn-light py-1 px-2 text-secondary" style="font-size: 0.8rem;">
                    <span>إدارة</span>
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Actionable KPI Alert Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm border-start border-4 border-warning h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">معاملات قيد الإجراء</div>
                        <h4 class="fw-bold mb-0 text-warning-emphasis">@Model.PendingProceduresCount</h4>
                    </div>
                    <div class="p-2 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">تتطلب مراجعة من الجهة المختصة أو الفريق</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm border-start border-4 border-danger h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">مواعيد متأخرة</div>
                        <h4 class="fw-bold mb-0 text-danger">@Model.OverdueDeadlinesCount</h4>
                    </div>
                    <div class="p-2 bg-danger-subtle text-danger rounded-circle">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">تجاوزت تاريخ الإنجاز المستهدف &bull; إجراء فوري</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm border-start border-4 border-info h-100">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">مستندات وشهادات ناقصة</div>
                        <h4 class="fw-bold mb-0 text-info-emphasis">@Model.ProceduresWithMissingDocsCount</h4>
                    </div>
                    <div class="p-2 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-file-earmark-x fs-4"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">بانتظار إرفاق صكوك أو وثائق ثبوتية</div>
            </div>
        </div>
    </div>
</div>

<!-- Grouping & Distribution Grids -->
<div class="row g-4 mb-4">
    <!-- Property Distribution -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pie-chart text-primary me-2"></i>توزيع العقارات المسجلة</span>
                <span class="badge bg-light text-muted border">إحصائيات فورية</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <h6 class="small text-muted text-uppercase fw-bold mb-2">حسب نوع العقار</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var kv in Model.PropertiesByType)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom">
                                    <span class="fw-semibold">
                                        @(kv.Key == "Land" ? "أرض" : (kv.Key == "Villa" ? "فيلا" : kv.Key))
                                    </span>
                                    <span class="badge badge-subtle-primary">@kv.Value</span>
                                </li>
                            }
                            @if (!Model.PropertiesByType.Any())
                            {
                                <li class="list-group-item text-muted small px-0">لا توجد عقارات مسجّلة.</li>
                            }
                        </ul>
                    </div>
                    <div class="col-sm-6">
                        <h6 class="small text-muted text-uppercase fw-bold mb-2">حسب الحالة التشغيلية</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var kv in Model.PropertiesByStatus)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom">
                                    <span class="fw-semibold">
                                        @switch (kv.Key)
                                        {
                                            case "Active": <span>نشط</span>; break;
                                            case "UnderReview": <span>قيد المراجعة</span>; break;
                                            case "Reserved": <span>محجوز</span>; break;
                                            case "Sold": <span>مباع</span>; break;
                                            case "Archived": <span>مؤرشف</span>; break;
                                            default: <span>@kv.Key</span>; break;
                                        }
                                    </span>
                                    <span class="badge badge-subtle-secondary">@kv.Value</span>
                                </li>
                            }
                            @if (!Model.PropertiesByStatus.Any())
                            {
                                <li class="list-group-item text-muted small px-0">لا توجد حالات مسجّلة.</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Procedures by Status -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 fw-bold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bar-chart-steps text-info me-2"></i>حالات المعاملات القانونية</span>
                <span class="badge bg-light text-muted border">المسارات النشطة</span>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var kv in Model.ProceduresByStatus)
                    {
                        <div class="col-sm-6">
                            <div class="p-2 border rounded-3 d-flex justify-content-between align-items-center bg-light">
                                <span class="fw-semibold small">
                                    @switch (kv.Key)
                                    {
                                        case "Submitted": <span>مُقدَّم</span>; break;
                                        case "InProgress": <span>قيد الإجراء</span>; break;
                                        case "PendingRequirements": <span>بانتظار متطلبات</span>; break;
                                        case "UnderReview": <span>قيد المراجعة</span>; break;
                                        case "Approved": <span>معتمد</span>; break;
                                        case "Rejected": <span>مرفوض</span>; break;
                                        case "Completed": <span>منجز</span>; break;
                                        case "Cancelled": <span>ملغى</span>; break;
                                        default: <span>@kv.Key</span>; break;
                                    }
                                </span>
                                <span class="badge bg-primary rounded-pill">@kv.Value</span>
                            </div>
                        </div>
                    }
                    @if (!Model.ProceduresByStatus.Any())
                    {
                        <div class="col-12 text-muted small py-4 text-center">لا توجد معاملات مسجّلة حالياً.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Tabbed Action Center -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-2 border-bottom">
        <ul class="nav nav-tabs card-header-tabs" id="dashboardTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                    <i class="bi bi-hourglass-split text-warning"></i>
                    <span>معاملات قيد الانتظار (@Model.PendingProcedures.Count)</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="missing-tab" data-bs-toggle="tab" data-bs-target="#missing" type="button" role="tab">
                    <i class="bi bi-file-earmark-x text-info"></i>
                    <span>مستندات ناقصة (@Model.ProceduresWithMissingDocuments.Count)</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="deadlines-tab" data-bs-toggle="tab" data-bs-target="#deadlines" type="button" role="tab">
                    <i class="bi bi-alarm text-danger"></i>
                    <span>مواعيد قادمة (@Model.UpcomingDeadlines.Count)</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content" id="dashboardTabsContent">
            <!-- Tab 1: Pending Procedures -->
            <div class="tab-pane fade show active" id="pending" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>نوع المعاملة</th>
                                <th>العقار المرتبط</th>
                                <th>الجهة المسؤولة</th>
                                <th>الحالة</th>
                                <th>الموعد القادم</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingProcedures.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-check-circle text-success fs-2 d-block mb-2"></i>
                                        جميع المعاملات مكتملة أو لا توجد معاملات معلقة حالياً.
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.PendingProcedures)
                            {
                                <tr>
                                    <td>
                                        <span class="badge badge-subtle-primary">@p.TypeLabel</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="fw-bold text-decoration-none text-primary">
                                            @p.PropertyReferenceNumber
                                        </a>
                                        <div class="small text-muted">@p.PropertyTitle</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(p.ResponsibleAuthority ?? "—")
                                        </span>
                                    </td>
                                    <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                    <td>
                                        @if (p.NextActionDeadline.HasValue)
                                        {
                                            var css = p.HasOverdueDeadline ? "text-danger fw-bold" : "text-body";
                                            <span class="@css">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @p.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                                @if (p.HasOverdueDeadline)
                                                {
                                                    <span class="badge bg-danger ms-1">متأخر</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                        <a asp-controller="Procedures" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 2: Missing Documents -->
            <div class="tab-pane fade" id="missing" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>نوع المعاملة</th>
                                <th>العقار</th>
                                <th>المتطلبات المعلقة</th>
                                <th>الحالة</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ProceduresWithMissingDocuments.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-file-earmark-check text-success fs-2 d-block mb-2"></i>
                                        لا توجد مستندات ناقصة في المعاملات النشطة.
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.ProceduresWithMissingDocuments)
                            {
                                <tr>
                                    <td><span class="badge badge-subtle-primary">@p.TypeLabel</span></td>
                                    <td>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="fw-bold text-decoration-none">
                                            @p.PropertyReferenceNumber
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-warning-emphasis d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-exclamation-circle text-warning"></i>
                                            @p.NextActionDescription
                                        </span>
                                    </td>
                                    <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                    <td class="text-end">
                                        <a asp-controller="Documents" asp-action="Upload" asp-route-propertyId="@p.PropertyId" asp-route-procedureId="@p.Id" class="btn btn-sm btn-success py-1 px-2 me-1">
                                            <i class="bi bi-cloud-arrow-up"></i> رفع المستند
                                        </a>
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 3: Upcoming Deadlines -->
            <div class="tab-pane fade" id="deadlines" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>الموعد النهائي</th>
                                <th>نوع المعاملة</th>
                                <th>العقار</th>
                                <th>المهمة / الإجراء المطلوب</th>
                                <th>الحالة</th>
                                <th class="text-end">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UpcomingDeadlines.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-check text-success fs-2 d-block mb-2"></i>
                                        لا توجد مواعيد قادمة مجدولة حالياً.
                                    </td>
                                </tr>
                            }
                            @foreach (var p in Model.UpcomingDeadlines)
                            {
                                <tr>
                                    <td>
                                        @if (p.NextActionDeadline.HasValue)
                                        {
                                            var css = p.HasOverdueDeadline ? "text-danger fw-bold" : "text-body fw-semibold";
                                            <span class="@css">
                                                <i class="bi bi-alarm me-1"></i>
                                                @p.NextActionDeadline.Value.ToString("yyyy-MM-dd")
                                                @if (p.HasOverdueDeadline)
                                                {
                                                    <span class="badge bg-danger ms-1">متأخر</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td><span class="badge badge-subtle-primary">@p.TypeLabel</span></td>
                                    <td>
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="fw-bold text-decoration-none">
                                            @p.PropertyReferenceNumber
                                        </a>
                                    </td>
                                    <td>@(p.NextActionDescription ?? "مراجعة معلقة")</td>
                                    <td><partial name="_ProcedureStatusBadge" model="p.Status" /></td>
                                    <td class="text-end">
                                        <a asp-controller="Procedures" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                        <a asp-controller="Procedures" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-1 px-2">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Administrative Activity Stream -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 fw-bold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history text-primary me-2"></i>النشاط الإداري والعمليات الأخيرة</span>
        <span class="badge bg-light text-muted border">
            <i class="bi bi-broadcast text-success me-1"></i>سجل مباشر
        </span>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentActivities.Any())
        {
            <div class="text-center text-muted py-5">لا يوجد نشاط حديث مسجّل حتى الآن.</div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var act in Model.RecentActivities)
                {
                    <div class="list-group-item p-3 border-0 border-bottom">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div class="d-flex align-items-start gap-2">
                                <div class="p-2 rounded-circle bg-light border text-primary mt-1">
                                    <i class="bi bi-activity"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @act.BadgeCss">@act.ActivityType</span>
                                        <strong class="text-dark">@act.Title</strong>
                                    </div>
                                    <div class="text-muted small mt-1">@act.Description</div>
                                </div>
                            </div>
                            <div class="text-end ms-auto">
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-clock me-1"></i>@act.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                </div>
                                @if (!string.IsNullOrWhiteSpace(act.LinkController) && act.LinkId.HasValue)
                                {
                                    <a asp-controller="@act.LinkController" asp-action="@act.LinkAction" asp-route-id="@act.LinkId.Value" class="btn btn-sm btn-link p-0 text-decoration-none text-primary fw-semibold">
                                        <span>فتح السجل</span>
                                        <i class="bi bi-arrow-left"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
